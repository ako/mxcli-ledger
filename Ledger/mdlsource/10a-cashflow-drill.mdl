-- ============================================================================
-- 10a - Cashflow inspector
-- ============================================================================
-- Clicking a cell in the matrix answers the question the matrix provokes:
-- 'Groceries went €35 over in March — on what?'. The transactions appear in a
-- panel beside the matrix, which is where the prototype put them.
--
-- Beside, not in a popup, and that is not only a layout choice. The panel is
-- part of the page, so it is populated on load rather than only after a click,
-- the matrix stays visible and comparable while the detail is read, and
-- clicking a second cell just repoints the panel. A popup hides the thing you
-- are asking questions about.
--
-- Consequence for the model: the selection lives on the page's ReportContext,
-- the same object the mode buttons already mutate. Refreshing it re-runs both
-- the matrix datasource and the list, which is how the selected cell gets its
-- outline and the panel its contents in one round trip.
--
-- Only category rows select. A group subtotal has no single category to list
-- and the net line has none at all, so both carry an empty CategoryIdText and
-- the handler declines. That is one guard rather than a row-kind check plus a
-- null check, because the key being empty *is* the condition.
--
-- Numbered 10a rather than 09 because it now reads the view entities defined in
-- 10 and 06a, and the files apply in order.
--
-- The selection travels as a casted id string rather than an association: a
-- view entity cannot carry one (CE6771), and a caller holding an id can fetch
-- the matching view rows without ever holding a Category (FINDINGS 74).
-- ============================================================================

/**
 * The transactions behind the selected cell: one category, one month.
 *
 * The filter lives here because two callers need the same rows — the panel's
 * list and its header figures — and they must not be able to disagree.
 *
 * Reads VTransactionLine, constrained on the category's casted id. Mirrors are
 * excluded by the view. The old version retrieved Transaction objects through
 * an association and left the caller to cross Transaction_Account per row.
 *
 * Returns nothing when no cell is selected: DrillCategoryId is empty, and no
 * row has an empty CategoryId.
 *
 * @param $Context The page's report context
 * @returns Transaction lines, oldest first
 */
create or modify microflow Ledger.GET_DrillTransactions ($Context: Ledger.ReportContext)
returns list of Ledger.VTransactionLine as $Txs
folder 'Cashflow'
begin
  declare $Start datetime = [%CurrentDateTime%];
  declare $End datetime = [%CurrentDateTime%];

  set $Start = addMonths(dateTime(2026, 1, 1), $Context/DrillMonthIndex - 1);
  set $End = addMonths($Start, 1);

  retrieve $Txs from Ledger.VTransactionLine
    where CategoryId = $Context/DrillCategoryId
      and TxDate >= $Start
      and TxDate < $End
    sort by Ledger.VTransactionLine.TxDate asc;

  return $Txs;
end;
/

/**
 * The inspector list, preformatted for display.
 *
 * @param $Context The page's report context
 * @returns One line per transaction, oldest first
 */
create or modify microflow Ledger.DS_DrillLines ($Context: Ledger.ReportContext)
returns list of Ledger.DrillLine as $Lines
folder 'Cashflow'
begin
  declare $N integer = 0;
  declare $Meta string = '';
  declare $Acct string = '';

  $Lines = create list of Ledger.DrillLine;

  $Txs = call microflow Ledger.GET_DrillTransactions (Context = $Context);

  loop $T in $Txs
  begin
    set $N = $N + 1;
    $Amount = call microflow Ledger.FMT_EuroCents (Amount = $T/SignedAmount);

    @annotation 'Plain column read: the join is in VTransactionLine'
    set $Acct = $T/AccountName;
    set $Meta = formatDateTime($T/TxDate, 'd MMM') + ' · ' + $Acct;

    $Line = create Ledger.DrillLine (
      Merchant = $T/Merchant,
      MetaText = $Meta,
      AmountText = $Amount,
      SortOrder = $N);
    add $Line to $Lines;
  end loop;

  return $Lines;
end;
/

/**
 * Points the inspector at one matrix cell.
 *
 * The figures come from the same three sources the matrix used — the
 * transaction list for the actual, CALC_Budget for the budget, and the same
 * elapsed window — so the panel cannot disagree with the cell that selected it.
 *
 * Ends by refreshing the context, which re-runs the matrix datasource as well
 * as the list. That is what draws the outline on the selected cell: the builder
 * reads the selection back off the context it was given.
 *
 * @param $Row The matrix row that was clicked
 * @param $MonthIndex 1-12
 * @returns true when the inspector moved
 */
create or modify microflow Ledger.ACT_DrillCell (
  $Row: Ledger.CashflowRow,
  $MonthIndex: integer
)
returns boolean as $Selected
folder 'Cashflow'
begin
  declare $Selected boolean = false;
  declare $MonthName string = '';
  declare $Budget decimal = 0;
  declare $ActualOut string = '';
  declare $BudgetOut string = '';
  declare $CountOut string = '';

  retrieve $Context from $Row/Ledger.CashflowRow_Context;

  @annotation 'Group and net rows carry no category id, so they do not select'
  if length($Row/CategoryIdText) > 0 then
    $MN = call microflow Ledger.FMT_MonthName (MonthIndex = $MonthIndex);
    set $MonthName = $MN;

    @annotation 'Point the context at the cell before reading its transactions'
    change $Context (
      DrillSortKey = $Row/SortOrder,
      DrillMonthIndex = $MonthIndex,
      DrillCategoryId = $Row/CategoryIdText);

    $Txs = call microflow Ledger.GET_DrillTransactions (Context = $Context);
    @annotation 'count() and sum() declare their own outputs — see FINDINGS 47'
    $Count = count($Txs);
    $Actual = sum($Txs.Amount);

    @annotation 'The budget comes off the same view the matrix reads, found by id rather than by walking an association to a Category'
    retrieve $Budgets from Ledger.VCategoryBudget;
    $BRow = find($Budgets, CategoryId = $Row/CategoryIdText);
    if $BRow != empty then
      $B = call microflow Ledger.GET_ViewBudget (B = $BRow, MonthIndex = $MonthIndex);
      set $Budget = $B;
    end if;

    $AT = call microflow Ledger.FMT_Euro (Amount = $Actual);
    set $ActualOut = $AT;
    $BT = call microflow Ledger.FMT_Euro (Amount = $Budget);
    set $BudgetOut = $BT;
    set $CountOut = if $Count = 1 then '1 transaction' else toString($Count) + ' transactions';

    change $Context (
      DrillKicker = $Row/GroupNameText,
      DrillTitle = $Row/Label + ' · ' + $MonthName + ' 2026',
      DrillMeta = $ActualOut + ' of ' + $BudgetOut + ' budget · ' + $CountOut)
      refresh;

    set $Selected = true;
  end if;

  return $Selected;
end;
/
