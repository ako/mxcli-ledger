-- ============================================================================
-- 06 - Cashflow report scaffolding (non-persistent)
-- ============================================================================
-- The category x month pivot is not a native Mendix control. It is tractable
-- only because the window is a fixed 12 months (PROTOTYPE-ANALYSIS §5.1): the
-- matrix is a DataGrid2 with 14 static columns (label + 12 months + total) over
-- a non-persistent row entity that a microflow builds.
--
-- Twelve month values live as attributes on the row rather than as twelve
-- associated cell objects. The analysis sketched cell objects, but DataGrid2
-- columns bind to attributes and align by construction, whereas a nested
-- gallery of cells would size its columns per row and not line up across rows.
-- The cost is a wide entity; that is report scaffolding, not domain data.
--
-- Bands drive the heatmap. tint() in the prototype computed a continuous alpha;
-- Mendix supplies class names, so the ratio is bucketed into over-1..over-5 /
-- under-1..under-5 and rendered by theme SCSS (PROTOTYPE-ANALYSIS §5.2).
-- ============================================================================

/** What a matrix row represents; drives styling and totalling. */
create or modify enumeration Ledger.RowKind (
  /** Group subtotal, e.g. Housing */
  Group 'Group',
  /** A single category */
  Category 'Category',
  /** The net cashflow line */
  Net 'Net'
);
/

/**
 * One row of the cashflow matrix.
 *
 * M01..M12 are January..December. Text is preformatted by the builder because
 * a cell shows an amount, a variance, or nothing at all depending on the mode
 * and on whether the month has happened yet.
 *
 * Band is a CSS class suffix, empty when the cell should not be tinted.
 */
create or modify non-persistent entity Ledger.CashflowRow (
  /** Row label — group name, category name, or 'Net cashflow' */
  Label: string(100),
  /** Group / Category / Net */
  RowKind: enumeration(Ledger.RowKind),
  /** Display order across the whole matrix */
  SortOrder: integer default 0,
  /** Row total, preformatted */
  TotalText: string(24),

  M01Text: string(24), M01Band: string(16),
  M02Text: string(24), M02Band: string(16),
  M03Text: string(24), M03Band: string(16),
  M04Text: string(24), M04Band: string(16),
  M05Text: string(24), M05Band: string(16),
  M06Text: string(24), M06Band: string(16),
  M07Text: string(24), M07Band: string(16),
  M08Text: string(24), M08Band: string(16),
  M09Text: string(24), M09Band: string(16),
  M10Text: string(24), M10Band: string(16),
  M11Text: string(24), M11Band: string(16),
  M12Text: string(24), M12Band: string(16)
);
/

/**
 * Screen state for the cashflow report: which mode is showing, plus the
 * headline figures. One object per page instance, built by DS_ReportContext.
 */
create or modify non-persistent entity Ledger.ReportContext (
  /** Actual / Budget / Variance */
  Mode: enumeration(Ledger.ReportMode),
  /** Explains what the current mode shows */
  Subheading: string(200),
  /** Total income over elapsed months */
  KpiIncome: string(24),
  /** Total spend over elapsed months */
  KpiSpend: string(24),
  /** Income minus spend */
  KpiNet: string(24),
  /** How many elapsed cells are over budget */
  KpiOver: string(24),
  /** Last month with actuals, 1-12 */
  ElapsedThrough: integer default 0
);
/

/**
 * What a drilled-into cell is showing: one category in one month, with the
 * same three figures the cell itself was built from.
 *
 * The transactions are not held here — they are a microflow datasource on the
 * popup, so the list is retrieved once by the grid rather than carried around.
 */
create or modify non-persistent entity Ledger.DrillContext (
  /** e.g. 'Groceries · March 2026' */
  Caption: string(160),
  /** 1-12 */
  MonthIndex: integer default 1,
  /** 'YYYY-MM' */
  MonthKey: string(7),
  /** Actual for the cell, preformatted */
  ActualText: string(24),
  /** Budget for the cell, preformatted */
  BudgetText: string(24),
  /** Signed variance, favourable positive */
  VarianceText: string(24),
  /** e.g. '9 transactions' */
  CountText: string(40)
);
/

/**
 * One line of the drilldown list.
 *
 * A preformatted copy of a Transaction rather than the Transaction itself.
 * MDL has no number or date format on a grid column, so a Decimal renders as
 * '-51.3' and a DateTime in the browser's locale — neither of which is what a
 * Dutch bank statement looks like. Formatting in the builder is the same choice
 * CashflowRow makes, for the same reason.
 */
create or modify non-persistent entity Ledger.DrillLine (
  /** Day and month, e.g. '5 Mar' — the year is in the popup title */
  DateText: string(16),
  /** Counterparty */
  Merchant: string(200),
  /** Payment reference */
  Description: string(500),
  /** Signed amount with cents, e.g. '-€ 51.30' */
  AmountText: string(24),
  /** Display order */
  SortOrder: integer default 0
);
/

/**
 * The category behind a matrix row.
 *
 * Group and net rows leave it empty, which is also what makes them
 * undrillable: there is no single category to show transactions for.
 */
create or modify association Ledger.CashflowRow_Category
  from Ledger.CashflowRow
  to Ledger.Category
  type reference
  owner default
  delete_behavior DELETE_BUT_KEEP_REFERENCES;
/

/** The category being drilled into. */
create or modify association Ledger.DrillContext_Category
  from Ledger.DrillContext
  to Ledger.Category
  type reference
  owner default
  delete_behavior DELETE_BUT_KEEP_REFERENCES;
/
