    'Expense' as 'Dépense',
    'Feb' as 'févr.',
    'Field' as 'Champ',
    'For "is one of", separate the alternatives with commas: Spotify,Netflix,iCloud' as 'Pour « est l''un de », séparez les alternatives par des virgules : Spotify,Netflix,iCloud',
    'From' as 'Du',
    'Give the rule something to match on.' as 'Donnez un critère à la règle.',
    'Group' as 'Groupe',
