-- ============================================================================
-- 32 - The theme switcher, on every page
-- ============================================================================
-- WHY THIS IS NOT IN THE TOPBAR, WHICH IS WHERE IT BELONGS. The topbar is part
-- of the layout, and mxcli says plainly what that means:
--
--   $ mxcli -p Ledger.mpr -c "DESCRIBE LAYOUT Atlas_Core.Atlas_Default"
--   -- Layouts cannot be created via MDL; they must be created in Studio Pro.
--
-- So nothing can be added beside the language selector without leaving the
-- toolchain this project is built with. The language selector is up there
-- because Atlas ships it, not because we put it there.
--
-- A snippet placed on every page is the closest thing MDL can author: one
-- definition, eight call sites, and a control that is in the same place on
-- every screen. It sits under the page title rather than above it, which is
-- the honest position for something the layout does not own.
--
-- THREE BUTTONS RATHER THAN A COMBO BOX. A combo box binds to an attribute,
-- an attribute needs a context object, and a context object on eight pages
-- that do not otherwise need one means a non-persistent entity, a data-source
-- microflow and a data view per page — machinery whose only purpose is to give
-- a dropdown something to bind to. Three buttons need none of it and read as a
-- segmented control. The trade is real and it is a trade: the set is fixed at
-- three, and adding a fourth theme means editing this file rather than only
-- re-running `theme apply`.
--
-- The nanoflows below are one per skin because a button passes no arguments.
-- SetAppSkin itself takes the name, and mxcli generated it against the set that
-- is actually installed — so a button here can never select a theme whose CSS
-- is not in the page.
-- ============================================================================

-- ----------------------------------------------------------------------------
-- This file used to repair two of mxcli's generated actions. It no longer does.
-- ----------------------------------------------------------------------------
-- `SetAppSkin` and `SetAppTheme` were dead on arrival: mxbuild lowers the first
-- letter of a JavaScript action's parameter when it generates the wrapper, and
-- mxcli wrote bodies using the modelled spelling, so the first click was
-- `ReferenceError: Skin is not defined`. This file carried corrected copies of
-- both bodies.
--
-- Fixed upstream in mxcli `55a44a77` (FINDINGS 135). The generated bodies now
-- use the lowercase name and say why in a comment, so the copies here were
-- doing nothing but drifting from their originals — a repair that outlives the
-- defect is just a second definition nobody diffs.
--
-- What this file still owns: the three nanoflows and the snippet. Those depend
-- on `mxcli theme switcher install` having created `SetAppSkin` first, which is
-- the ordering finding 118 is about.
-- ----------------------------------------------------------------------------

create or modify nanoflow Ledger.ACT_SkinLedgerPaper ()
returns String
begin
  @position(360, 200)
  $Skin = call javascript action Ledger.SetAppSkin(Skin = 'ledgerpaper');
  @position(520, 200)
  return $Skin;
end;
/

create or modify nanoflow Ledger.ACT_SkinIng ()
returns String
begin
  @position(360, 200)
  $Skin = call javascript action Ledger.SetAppSkin(Skin = 'ing');
  @position(520, 200)
  return $Skin;
end;
/

create or modify nanoflow Ledger.ACT_SkinRabobank ()
returns String
begin
  @position(360, 200)
  $Skin = call javascript action Ledger.SetAppSkin(Skin = 'rabobank');
  @position(520, 200)
  return $Skin;
end;
/

/**
 * The theme bar.
 *
 * No parameters and no data source: every button calls a nanoflow that runs
 * entirely in the client, so this snippet can go on any page regardless of
 * what that page's data view holds.
 */
create or replace snippet Ledger.SNIPPET_ThemeBar
{
  container ctnThemeBar (Class: 'ledger-themebar') {
    dynamictext txtThemeLabel (
      Content: 'Theme',
      RenderMode: paragraph,
      Class: 'ledger-themebar-label'
    )
    actionbutton btnSkinPaper (
      Caption: 'Ledger Paper',
      Action: nanoflow Ledger.ACT_SkinLedgerPaper,
      Class: 'ledger-themebar-btn'
    )
    actionbutton btnSkinIng (
      Caption: 'ING',
      Action: nanoflow Ledger.ACT_SkinIng,
      Class: 'ledger-themebar-btn'
    )
    actionbutton btnSkinRabo (
      Caption: 'Rabobank',
      Action: nanoflow Ledger.ACT_SkinRabobank,
      Class: 'ledger-themebar-btn'
    )
  }
}
/
