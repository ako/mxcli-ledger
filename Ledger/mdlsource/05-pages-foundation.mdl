-- ============================================================================
-- 05 - Foundation pages: Accounts, Categories & rules, Transactions
-- ============================================================================
-- Atlas-native rather than a reproduction of the prototype's bespoke design
-- system (see ../../PROTOTYPE-ANALYSIS.md §3). Layout, grouping and the
-- needs-review emphasis carry over; the IBM Plex / warm-paper styling does not.
--
-- Cashflow and Budgets are phase 3 — they need the pivot matrix.
-- ============================================================================

/**
 * Shared sidebar navigation for the Ledger screens.
 *
 * Created empty first, then filled in at the bottom of this script. The snippet
 * and the pages reference each other, and mxcli resolves references strictly in
 * statement order, so one side has to start as a stub.
 */
-- The in-page menu card is gone. It existed because the Atlas sidebar collapses
-- to a 48px strip of clipped labels by default, so the app needed navigation
-- somewhere visible. Setting --navsidebar-width-closed equal to the open width
-- keeps the real sidebar open, which is both what the prototype has and what
-- gives the twelve-month matrix back a quarter of the page.

/**
 * Account cards: balance, type and the date of the last import.
 */
create or replace page Ledger.Account_Overview
(
  title: 'Accounts',
  layout: Atlas_Core.Atlas_Default,
  url: 'accounts',
  folder: 'Ledger'
)
{
  layoutgrid lgAccounts {
    row rowMain {
      column colBody (desktopwidth: 12) {
        dynamictext txtHeading (content: 'Accounts', rendermode: H2)
        snippetcall scThemeBar (snippet: Ledger.SNIPPET_ThemeBar)
        dynamictext txtSub (content: 'Balances as of the last import.', class: 'text-muted')

        gallery galAccounts (
          datasource: database from Ledger.Account sort by SortOrder asc,
          DesktopColumns: 2,
          TabletColumns: 1,
          PhoneColumns: 1
        ) {
          template tplAccount {
            container ctnCard (class: 'card') {
              dynamictext txtName (attribute: Name, rendermode: H4)
              dynamictext txtIban (attribute: IBAN, rendermode: paragraph, class: 'text-muted')
              dynamictext txtBalance (
                content: '€ {1}',
                contentparams: [{1} = Balance],
                rendermode: H3)
              -- Deliberately one widget, not two. Consecutive dynamictexts
              -- render inline whatever RenderMode says, so two of them here
              -- produce '€ 310Last import: 7/24/2026' with no separator.
              dynamictext txtFooter (
                content: 'This month: € {1}  ·  Last import: {2}',
                -- contentparams accepts attribute names only; an expression here
                -- is stored as if it were an attribute and fails CE1613.
                contentparams: [{1} = MonthDelta, {2} = LastImport],
                rendermode: paragraph,
                class: 'text-muted')
            }
          }
        }
      }
    }
  }
}
/

/**
 * The two-level taxonomy and the categorisation rules that feed it.
 *
 * Rules are shown in evaluation order — first match wins on import.
 */
create or replace page Ledger.Category_Overview
(
  title: 'Categories & rules',
  layout: Atlas_Core.Atlas_Default,
  url: 'categories',
  folder: 'Ledger'
)
{
  layoutgrid lgCategories {
    row rowMain {
      column colBody (desktopwidth: 12) {
        dynamictext txtHeading (content: 'Categories & rules', rendermode: H2)
        snippetcall scThemeBar (snippet: Ledger.SNIPPET_ThemeBar)
        dynamictext txtSub (
          content: 'Two-level taxonomy plus the rules that assign categories on import. First match wins.',
          class: 'text-muted')

        dynamictext txtCatsHeading (content: 'Categories', rendermode: H4)
        datagrid dgCategories (
          datasource: database from Ledger.Category sort by SortOrder asc
        ) {
          column colCatName (attribute: Name, caption: 'Category')
          column colCatBudget (attribute: BaselineBudget, caption: 'Baseline budget / mo', Alignment: right)
          column colCatOrder (attribute: SortOrder, caption: 'Order', Alignment: right)
        }

        dynamictext txtRulesHeading (content: 'Rules', rendermode: H4)
        datagrid dgRules (
          datasource: database from Ledger.CategoryRule sort by SortOrder asc
        ) {
          column colRuleOrder (attribute: SortOrder, caption: '#', Alignment: right)
          column colRuleField (attribute: RuleField, caption: 'Field')
          column colRuleOp (attribute: RuleOperator, caption: 'Operator')
          column colRuleValue (attribute: MatchValue, caption: 'Value')
          column colRuleHits (attribute: MatchCount, caption: 'Matched', Alignment: right)
        }
      }
    }
  }
}
/

/**
 * Keeps SignedAmount consistent with the category the transaction is in.
 *
 * Amount is always positive and SignedAmount carries the direction, so the
 * direction is a function of the category's group type — and it therefore has
 * to be recomputed whenever the category changes. An uncategorised row is
 * seeded negative (it is nearly always spend), and assigning it to Salary
 * without this would leave a negative income in every figure derived from
 * SignedAmount.
 *
 * @param $Tx The transaction to fix up
 * @returns true
 */
create or modify microflow Ledger.SET_TransactionSign ($Tx: Ledger.Transaction)
returns boolean as $Ok
folder 'Ledger'
begin
  declare $Ok boolean = true;
  declare $IsIncome boolean = false;

  if $Tx/Ledger.Transaction_Category != empty then
    @annotation 'Two hops in memory, not two queries: the category is already on the object being saved, and its group is already on the category.'
    retrieve $Cat from $Tx/Ledger.Transaction_Category;
    retrieve $Grp from $Cat/Ledger.Category_CategoryGroup;
    if $Grp != empty then
      set $IsIncome = $Grp/GroupType = Ledger.GroupType.Income;
    end if;
  end if;

  change $Tx (SignedAmount = if $IsIncome then $Tx/Amount else -$Tx/Amount);
  return $Ok;
end;
/

grant execute on microflow Ledger.SET_TransactionSign to Ledger.User;
/

/**
 * Saves an edited transaction.
 *
 * A microflow rather than the built-in Save, because the sign has to be
 * recomputed before the commit — see SET_TransactionSign.
 *
 * @param $Tx The edited transaction
 * @returns true
 */
create or modify microflow Ledger.ACT_SaveTransaction ($Tx: Ledger.Transaction)
returns boolean as $Ok
folder 'Ledger'
begin
  declare $Ok boolean = true;
  $Signed = call microflow Ledger.SET_TransactionSign (Tx = $Tx);
  @annotation 'Refresh in client, not a plain commit. Without it the row stays in the needs-review grid after being categorised — the database is right and the screen is not, which reads as the save having failed.'
  commit $Tx refresh;
  close page;
  return $Ok;
end;
/

grant execute on microflow Ledger.ACT_SaveTransaction to Ledger.User;
/

/**
 * Edit one transaction.
 *
 * Reached by clicking a row in either grid on Transaction_Overview. The amount
 * is shown but not editable: it is what the bank said, and the one field here
 * that is genuinely a fact rather than a judgement. Everything a person decides
 * — which category, which account, how the merchant should read — is editable.
 *
 * @param $Tx The clicked transaction
 */
create or replace page Ledger.Transaction_Edit
(
  params: {
    $Tx: Ledger.Transaction
  },
  title: 'Transaction',
  layout: Atlas_Core.PopupLayout,
  folder: 'Ledger'
)
{
  -- The layout grid is where the popup's margins come from; Atlas' popup layout
  -- gives its content region no gutters of its own (see 06b).
  layoutgrid lgEdit {
    row rowEdit {
      column colEdit (desktopwidth: 12) {
        dataview dvEdit (datasource: $Tx) {
          container ctnEditAmount (class: 'ledger-tx-head') {
            dynamictext txtEditAmount (
              content: '€ {1}',
              contentparams: [{1} = Amount format (decimalPrecision: 2, groupDigits: true)],
              rendermode: H3)
            dynamictext txtEditHint (
              content: 'The amount is what the bank reported and is not edited here. Its sign follows the category.',
              rendermode: paragraph,
              class: 'text-muted')
          }

          datepicker dpEditDate (label: 'Date', attribute: TxDate)
          textbox tbEditMerchant (label: 'Merchant', attribute: Merchant)
          textbox tbEditDesc (label: 'Description', attribute: Description)
          combobox cbEditAccount (
            label: 'Account',
            attribute: Transaction_Account,
            datasource: database Ledger.Account,
            CaptionAttribute: Name)
          combobox cbEditCategory (
            label: 'Category',
            attribute: Transaction_Category,
            datasource: database Ledger.Category,
            CaptionAttribute: Name)

          footer ftEdit {
            actionbutton btnEditSave (
              caption: 'Save',
              action: microflow Ledger.ACT_SaveTransaction(Tx: $currentObject),
              buttonstyle: primary)
            actionbutton btnEditCancel (caption: 'Cancel', action: cancel_changes)
          }
        }
      }
    }
  }
}
/

grant view on page Ledger.Transaction_Edit to Ledger.User;
/

/**
 * Transaction list.
 *
 * Uncategorised rows are the point of this screen — they stay out of the
 * cashflow report until a category is assigned, so they are surfaced in their
 * own grid above the full list rather than being buried in it.
 *
 * Both grids are searchable, sortable and paged, and both open a row for
 * editing on click. They did none of those things at first, which made the
 * screen a wall of 932 rows with no way to act on the twelve that needed
 * attention.
 *
 * Two things are worth knowing about a Data Grid 2 column:
 *
 *   * A column that shows dynamic text can still be sorted and filtered, as
 *     long as it also names the attribute it is built from. Without the
 *     attribute the column is display-only — which is how the date and amount
 *     columns here started out, formatted but dead.
 *   * `attribute: Assoc/Attr` reads over an association, so category and
 *     account are ordinary sortable columns rather than nested data views.
 *   * `Size` is a ratio and only means anything alongside `ColumnWidth:
 *     manual` — on its own it builds an invalid column (CE0463, FINDINGS 107).
 *     Every column here carries both. Sizes are also given as a set rather than
 *     sprinkled on the two columns that seemed to need one: setting date and
 *     amount to 130 and leaving the rest at the default 1 asks for
 *     130:1:1:1:130, which drew the middle three at nothing — blank headers,
 *     blank cells, and a screen that looked like the data had gone missing.
 *   * A filter widget belongs to a column, in a `filter { }` block inside it. A
 *     `filter { }` at grid level parses and applies and is then silently
 *     dropped — it never reaches the model, so the grid renders with no filters
 *     and nothing says why.
 */
create or replace page Ledger.Transaction_Overview
(
  title: 'Transactions',
  layout: Atlas_Core.Atlas_Default,
  url: 'transactions',
  folder: 'Ledger'
)
{
  layoutgrid lgTransactions {
    row rowMain {
      column colBody (desktopwidth: 12) {
        dynamictext txtHeading (content: 'Transactions', rendermode: H2)
        snippetcall scThemeBar (snippet: Ledger.SNIPPET_ThemeBar)
        dynamictext txtSub (
          content: 'Transactions with no category stay out of the cashflow report until assigned. Click any row to edit it.',
          class: 'text-muted')

        dynamictext txtNeedsReview (content: 'Needs review', rendermode: H4)
        datagrid dgNeedsReview (
          datasource: database from Ledger.Transaction
            where [not(Ledger.Transaction_Category/Ledger.Category)]
            sort by TxDate desc,
          PageSize: 10,
          onclick: show_page Ledger.Transaction_Edit(Tx: $currentObject),
          class: 'ledger-grid-clickable'
        ) {
          column colNrDate (
            attribute: TxDate, caption: 'Date', ColumnWidth: manual, Size: 2,
            ShowContentAs: dynamicText,
            Content: '{1}',
            ContentParams: [{1} = TxDate format (dateFormat: Custom, customDateFormat: 'd MMM yyyy')]
          ) {
            filter fltNrDate { datefilter ftNrDate (attribute: TxDate) }
          }
          column colNrMerchant (
            attribute: Merchant, caption: 'Merchant', ColumnWidth: manual, Size: 3
          ) {
            filter fltNrMerchant { textfilter ftNrMerchant (attribute: Merchant) }
          }
          column colNrDesc (
            attribute: Description, caption: 'Description', ColumnWidth: manual, Size: 4
          ) {
            filter fltNrDesc { textfilter ftNrDesc (attribute: Description) }
          }
          column colNrAccount (
            attribute: Transaction_Account/Name, caption: 'Account',
            ColumnWidth: manual, Size: 2)
          column colNrAmount (
            attribute: SignedAmount, caption: 'Amount', Alignment: right,
            ColumnWidth: manual, Size: 2,
            ShowContentAs: dynamicText,
            Content: '{1}',
            ContentParams: [{1} = SignedAmount format (decimalPrecision: 2, groupDigits: true)]
          ) {
            filter fltNrAmount { numberfilter ftNrAmount (attribute: SignedAmount) }
          }
        }

        dynamictext txtAll (content: 'All transactions', rendermode: H4)
        datagrid dgTransactions (
          datasource: database from Ledger.Transaction
            where [IsMirror = false]
            sort by TxDate desc,
          PageSize: 25,
          PagingPosition: both,
          onclick: show_page Ledger.Transaction_Edit(Tx: $currentObject),
          class: 'ledger-grid-clickable'
        ) {
          column colDate (
            attribute: TxDate, caption: 'Date', ColumnWidth: manual, Size: 2,
            ShowContentAs: dynamicText,
            Content: '{1}',
            ContentParams: [{1} = TxDate format (dateFormat: Custom, customDateFormat: 'd MMM yyyy')]
          ) {
            filter fltDate { datefilter ftDate (attribute: TxDate) }
          }
          column colMerchant (
            attribute: Merchant, caption: 'Merchant', ColumnWidth: manual, Size: 3
          ) {
            filter fltMerchant { textfilter ftMerchant (attribute: Merchant) }
          }
          column colDesc (
            attribute: Description, caption: 'Description', ColumnWidth: manual, Size: 4
          ) {
            filter fltDesc { textfilter ftDesc (attribute: Description) }
          }
          column colAccount (
            attribute: Transaction_Account/Name, caption: 'Account',
            ColumnWidth: manual, Size: 2)
          column colCategory (
            attribute: Transaction_Category/Name, caption: 'Category',
            ColumnWidth: manual, Size: 2)
          column colAmount (
            attribute: SignedAmount, caption: 'Amount', Alignment: right,
            ColumnWidth: manual, Size: 2,
            ShowContentAs: dynamicText,
            Content: '{1}',
            ContentParams: [{1} = SignedAmount format (decimalPrecision: 2, groupDigits: true)]
          ) {
            filter fltAmount { numberfilter ftAmount (attribute: SignedAmount) }
          }
        }
      }
    }
  }
}
/

-- Navigation is not written here, and the doc comment that used to introduce it
-- is gone with it. It was left behind as a `/** … */` block documenting a
-- statement that no longer existed, which is not a comment the parser will
-- accept: a doc comment has to attach to something. This whole file failed to
-- parse from that moment on — `mxcli check` and `mxcli exec` both refused it,
-- so file 05 could not be re-applied and a cold rebuild from mdlsource would
-- have stopped here. See FINDINGS 106.
--
-- The menu itself moved because it is page-spanning state: four files each
-- carried the version of it that was true when they were written, so running
-- any one of them reverted the menu to an older shape. It has a single owner
-- now, 27-navigation.mdl, which runs after every page it names exists.
