-- ============================================================================
-- 22 - Dashboard page
-- ============================================================================
-- One chart, where there used to be two.
--
-- The sunburst and the sankey are gone. Each was Plotly through CustomChart,
-- each answered a single question, and neither answered it densely: a donut
-- spent a screen on thirteen numbers, a sankey spent one on about twenty, and
-- both were shape-first — you read the picture, then went hunting for the
-- figure. Neither showed a trend, an outlier, or anything you could act on.
--
-- What replaces them is a table of sparklines. The form is Tufte's, and the
-- argument for it is his: at this size the eye compares rows, and comparison
-- is the whole job of a dashboard. Thirteen categories, twenty months, four
-- readings each, above the fold.
--
--   the strip     income above the axis, spend below, net through the middle,
--                 twenty months — the macro reading, before any detail
--   the shape     each category's own twenty months against the band it
--                 usually occupies, so an unusual month reads as a departure
--                 rather than as a number you have to hold in your head
--   the trend     this year against the same months of last year, as a bar
--                 either side of zero — direction and size in one mark
--   the standing  how much of the category recurs, because that is the part
--                 cancelling actually removes
--
-- Uncategorised transactions are a row in the table, not a badge in a corner.
-- They want the same four readings as anything else, and a row cannot be
-- dismissed the way a number off to one side can.
--
-- Nothing here is chartjunk by omission: there is no legend (the rows are
-- labelled), no gridlines on the sparklines (the band is the reference), no
-- axis on the delta column (zero is drawn, and the bar is read against it),
-- and no colour that does not mean something.
--
-- All four columns are one Vega-Lite spec, an hconcat of faceted panels sharing
-- a row order — Vega-Lite cannot put a concatenation inside a facet, so the
-- table has to be built the other way round. Only the first panel carries
-- labels, and the rows line up only because every panel declares the same
-- height, the same sort, the same facet domain, and `bounds: flush`. Equal
-- height alone is not enough and the failure is silent; the notes on each
-- property say what breaks without it, and finding 94 has the measurements.
-- ============================================================================

/**
 * Dashboard: everything at once, one row per category.
 */
create or replace page Ledger.Dashboard
(
  title: 'Dashboard',
  layout: Atlas_Core.Atlas_Default,
  url: 'dashboard',
  folder: 'Ledger'
)
{
  layoutgrid lgDash {
    row rowDashMain {
      column colDashBody (desktopwidth: 12) {
        dataview dvDash (datasource: microflow Ledger.DS_OverviewContext) {
          dynamictext txtDashHeading (content: 'Dashboard', rendermode: H2)
          dynamictext txtDashSub (attribute: SubText, rendermode: paragraph, class: 'text-muted')

          layoutgrid lgDashSplit {
            row rowDashSplit {
              -- The chart, and beside it the transactions behind whatever row is
              -- selected. Same arrangement as the Cashflow screen, for the same
              -- reason: the figure and the rows that make it up belong on one
              -- screen, and a click that only redraws a chart leaves you asking
              -- "which ones?".
              column colDashChart (desktopwidth: 9) {
          container ctnOverviewCard (class: 'card ledger-card') {
            -- Counted, not written down. This read 'Twenty months, thirteen
            -- categories' as a literal until a fourteenth and a fifteenth were
            -- added, at which point it sat one line under a subheading that
            -- correctly said '15 categories' and contradicted it.
            dynamictext lblOverview (
              content: '{1} months, {2} categories. Line is the month, band is the range that category usually sits in, red is a month outside it. Click a row to list what is behind it.',
              contentparams: [{1} = MonthSpan, {2} = CategoryCount],
              rendermode: paragraph,
              class: 'text-muted')

            pluggablewidget 'ledger.widget.web.vegachart.VegaChart' chartOverview (
              chartData: TableData,
              datasetName: 'table',
              -- Zero: the container takes whatever the chart renders at. The
              -- table is a facet row per category, so its height is a fact
              -- about the data, and 620 was a measurement of one particular
              -- day's data. Fifteen rows filled it exactly and sixteen drew
              -- 29px past it, into the card's padding.
              chartHeight: 0,
              renderer: 'svg',
              showActions: false,
              selection: SelectedPoint,
              onClick: microflow Ledger.ACT_SelectOverviewCategory(Context: $currentObject),
              spec: '{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "data": {"name": "table"},
  "background": null,
  "paddingNote": "Forty on the left, because flush bounds do not measure the row header. The category labels are laid out to the left of the panel origin and the view is only as wide as the layout says it is, so the longest label was being cut off by the SVG viewport - a clip, not a truncation, with no ellipsis to give it away. The padding is the reserve the layout no longer computes.",
  "padding": {"left": 40, "top": 4, "right": 12, "bottom": 4},
  "config": {
    "view": {"stroke": null},
    "axis": {"labelFont": "IBM Plex Mono", "labelFontSize": 8, "labelColor": "#8A8378",
             "domainColor": "#D9D2C6", "tickColor": "#D9D2C6", "gridColor": "#F2EEE6"},
    "header": {"labelFont": "IBM Plex Sans", "labelFontSize": 10, "labelColor": "#17181A",
               "labelAnchor": "start", "labelPadding": 2, "titleFontSize": 9,
               "titleColor": "#8A8378", "titleAnchor": "start"},
    "title": {"font": "IBM Plex Sans", "fontSize": 10, "color": "#8A8378",
              "fontWeight": 500, "anchor": "start", "offset": 6},
    "facet": {
      "description": "Tight rows. Fourteen of them have to fit, and the gap between sparklines carries no information - Tufte would spend the pixels on months rather than on air.",
      "spacing": 3
    }
  },
  "vconcat": [
    {
      "title": "Income above, spend below, net through the middle",
      "description": "The macro reading. Derived from the same monthly rows the table below uses - income and spend are the two signs of one aggregate, so no second dataset exists for this.",
      "transform": [{"filter": "datum.k === \'m\'"}],
      "widthNote": "Matched to the table below it, not to the card - a width chosen against the card overhangs the view on the right and loses its last months. The table is now five columns wide (118 + 300 + 130 + 74 + 130 plus the gaps between them), and this is that, less the axis labels the strip needs and the table does not.",
      "width": 700,
      "height": 110,
      "layer": [
        {
          "transform": [
            {"calculate": "datum.kind === \'Income\' ? datum.v : -datum.v", "as": "signed"}
          ],
          "mark": {"type": "area", "interpolate": "monotone", "opacity": 0.9},
          "encoding": {
            "y": {"field": "signed", "type": "quantitative", "aggregate": "sum", "stack": "zero",
                  "axis": {"title": null, "format": ",.0f", "grid": true, "tickCount": 3}},
            "color": {
              "field": "kind", "type": "nominal", "legend": null,
              "scale": {"domain": ["Income", "Expense"], "range": ["#4E9E74", "#8A5A2B"]}
            }
          }
        },
        {
          "description": "Net. The only line on the strip, so it needs no legend to be the thing you read.",
          "transform": [
            {"calculate": "datum.kind === \'Income\' ? datum.v : -datum.v", "as": "signed"},
            {"aggregate": [{"op": "sum", "field": "signed", "as": "net"}], "groupby": ["t"]}
          ],
          "mark": {"type": "line", "color": "#17181A", "strokeWidth": 1.5, "interpolate": "monotone"},
          "encoding": {
            "y": {"field": "net", "type": "quantitative"},
            "tooltip": [
              {"field": "t", "type": "temporal", "title": "Month", "format": "%b %Y"},
              {"field": "net", "type": "quantitative", "title": "Net", "format": ",.2f"}
            ]
          }
        },
        {
          "mark": {"type": "rule", "color": "#8A8378", "strokeWidth": 1},
          "encoding": {"y": {"datum": 0}}
        }
      ],
      "encoding": {
        "x": {"field": "t", "type": "temporal",
              "axisNote": "One tick per year rather than a fixed count. tickCount: 10 put ten ticks wherever they fell, which was fine across twenty months and collided into \'Jan 22Apr 22\' across fifty-six. An interval tick lands on January whatever the span is, and the labels can never crowd because there is one per year.",
              "axis": {"title": null, "format": "%Y", "tickCount": {"interval": "year", "step": 1}, "grid": false}}
      }
    },
    {
      "description": "The table. Four columns, each faceted by category on the same sort and the same row height, so the rows line up across panels without being one chart.",
      "hconcat": [
        {
          "titleNote": "The category names are a column of the table, not a facet header, and that is a consequence of `bounds: flush`. Flush layout does not measure the row header, so every row\'s header group came to rest wherever its own text ended - each label right-anchored at its own x, ragged across sixty pixels, while the DOM insisted every one of them was text-anchor=end. Drawn as a text mark in a panel of its own, alignment is exact by construction, and the labels become what they always were: the first column.",
          "transform": [{"filter": "datum.k === \'s\'"}],
          "bounds": "flush",
          "facet": {
            "row": {
              "field": "cat", "type": "nominal", "title": null,
              "sort": {"op": "max", "field": "ord", "order": "descending"},
              "header": {"labels": false}
            }
          },
          "spec": {
            "width": 118,
            "height": 26,
            "mark": {"type": "text", "align": "right", "font": "IBM Plex Sans", "fontSize": 10, "color": "#17181A"},
            "encoding": {
              "x": {"datum": 118, "axis": null, "scale": {"domain": [0, 118]}},
              "text": {"field": "cat", "type": "nominal"}
            }
          }
        },
        {
          "title": "Each month against the usual range",
          "titleNote": "The span is not named here. It used to read \'Twenty months\', which was true when the seed generated twenty and a lie the moment it generated fifty-six — and unlike the caption above, a title inside a static spec cannot count anything. The caption states the span once; a panel header repeating it is a second copy that can only ever go stale.",
          "transform": [{"filter": "datum.k === \'m\'"}],
          "bounds": "flush",
          "boundsNote": "Every panel is flush, and that is what makes the table a table. Vega-Lite sizes a facet row to its content bounds by default, so a panel whose marks overflow the declared 26px - an outlier dot straddling the top of the sparkline, a rule drawn to the row edge - gets taller rows than a panel of plain text. Four panels, three different row pitches, and by the fourteenth category the labels sat a full row below their numbers.",
          "facet": {
            "row": {
              "field": "cat", "type": "nominal", "title": null,
              "sort": {"op": "max", "field": "ord", "order": "descending"},
              "header": {"labels": false}
            }
          },
          "resolve": {
            "description": "Independent y per row. A shared scale is more comparable in principle and useless in practice here - Salary at 43,661 against Subscriptions at 514 presses twelve of the thirteen flat against the axis. Each sparkline is read for its shape against its own band, which is what the band is for.",
            "scale": {"y": "independent"}
          },
          "spec": {
            "width": 300,
            "height": 26,
            "transform": [
              {
                "description": "One point per month, first, before anything else. The model emits a row per category per month per *account*, and the review row is a row per transaction - so a category held on two accounts arrives as two values at the same x. A line mark does not aggregate; it joins them in order, which drew a sawtooth for every multi-account category and a single vertical stroke for the review row. Summing here also fixes the band, which was otherwise a deviation over per-account rows rather than over months.",
                "aggregate": [{"op": "sum", "field": "v", "as": "v"}],
                "groupbyNote": "ord is in the groupby only to keep it alive. It is constant per category and nothing in this panel plots it - but the facet row domain is built from the data as the spec leaves it, so aggregating ord away made the row sort silently fall back to alphabetical while the other three panels stayed on the sort. The four columns then named different rows.",
                "groupby": ["cat", "t", "ord"]
              },
              {
                "description": "The band a category usually occupies. A window over its own months rather than a global one - EUR 1,500 is ordinary for Rent and extraordinary for Coffee, and a shared band would say the opposite.",
                "joinaggregate": [
                  {"op": "mean", "field": "v", "as": "m"},
                  {"op": "stdev", "field": "v", "as": "sd"}
                ],
                "groupby": ["cat"]
              },
              {
                "description": "How many months this category actually has. A line needs two points; the review row is twelve transactions in a single month, so without this its row renders empty - which reads as nothing to see, the exact opposite of what it means.",
                "joinaggregate": [{"op": "count", "as": "n"}],
                "groupby": ["cat"]
              },
              {"calculate": "max(datum.m - datum.sd, 0)", "as": "lo"},
              {"calculate": "datum.m + datum.sd", "as": "hi"},
              {"description": "Two deviations, not one. The band is drawn at one - that is what usual looks like - but a mark that fires on one in six months is decoration. At two it fires on the months actually worth opening.", "calculate": "datum.v > datum.m + 2 * datum.sd ? 1 : 0", "as": "outside"}
            ],
            "layer": [
              {
                "mark": {"type": "area", "color": "#D9D2C6", "opacity": 0.35},
                "encoding": {
                  "y": {"field": "lo", "type": "quantitative", "axis": null},
                  "y2": {"field": "hi"}
                }
              },
              {
                "mark": {"type": "line", "color": "#1B4D4B", "strokeWidth": 1.2},
                "encoding": {"y": {"field": "v", "type": "quantitative", "axis": null}}
              },
              {
                "description": "A category with a single month, drawn as the point the line cannot be.",
                "transform": [{"filter": "datum.n === 1"}],
                "mark": {"type": "point", "color": "#1B4D4B", "size": 18, "filled": true},
                "encoding": {"y": {"field": "v", "type": "quantitative", "axis": null}}
              },
              {
                "description": "Months above the band. The only strong colour in the panel, and it marks the thing worth opening.",
                "transform": [{"filter": "datum.outside === 1"}],
                "mark": {"type": "point", "color": "#A8321E", "size": 22, "filled": true},
                "encoding": {
                  "y": {"field": "v", "type": "quantitative", "axis": null},
                  "tooltip": [
                    {"field": "cat", "type": "nominal", "title": "Category"},
                    {"field": "t", "type": "temporal", "title": "Month", "format": "%b %Y"},
                    {"field": "v", "type": "quantitative", "title": "Spent", "format": ",.2f"},
                    {"field": "hi", "type": "quantitative", "title": "Usual ceiling", "format": ",.2f"}
                  ]
                }
              }
            ],
            "encoding": {
              "x": {"field": "t", "type": "temporal", "axis": null}
            }
          }
        },
        {
          "title": "vs last year",
          "description": "Direction and size in one mark, read against a drawn zero. No axis: the bar is the comparison, and a scale would invite reading absolute values that the sparkline already gives.",
          "transform": [{"filter": "datum.k === \'s\'"}],
          "bounds": "flush",
          "facet": {
            "row": {
              "field": "cat", "type": "nominal", "title": null,
              "sort": {"op": "max", "field": "ord", "order": "descending"},
              "header": {"labels": false}
            }
          },
          "spec": {
            "width": 130,
            "height": 26,
            "transform": [
              {
                "description": "Favourable is not the same direction for income as for spend, and neither for a review backlog - more of that is simply worse.",
                "calculate": "datum.kind === \'Income\' ? (datum.delta >= 0 ? \'better\' : \'worse\') : (datum.delta <= 0 ? \'better\' : \'worse\')",
                "as": "dir"
              }
            ],
            "layer": [
              {
                "mark": {"type": "bar", "height": 9, "cornerRadius": 1},
                "encoding": {
                  "x": {"field": "delta", "type": "quantitative", "axis": null},
                  "x2": {"datum": 0},
                  "color": {
                    "field": "dir", "type": "nominal", "legend": null,
                    "scale": {"domain": ["better", "worse"], "range": ["#2C6E4A", "#A8321E"]}
                  },
                  "tooltip": [
                    {"field": "cat", "type": "nominal", "title": "Category"},
                    {"field": "prior", "type": "quantitative", "title": "Last year", "format": ",.2f"},
                    {"field": "current", "type": "quantitative", "title": "This year", "format": ",.2f"},
                    {"field": "delta", "type": "quantitative", "title": "Change", "format": "+,.2f"}
                  ]
                }
              },
              {
                "mark": {"type": "rule", "color": "#8A8378", "strokeWidth": 1},
                "encoding": {"x": {"datum": 0}}
              }
            ]
          }
        },
        {
          "title": "this year",
          "description": "Direct labels rather than a fourth axis. At thirteen rows the numbers fit, and a number you can read is worth more than a bar you have to measure.",
          "transform": [{"filter": "datum.k === \'s\'"}],
          "bounds": "flush",
          "facet": {
            "row": {
              "field": "cat", "type": "nominal", "title": null,
              "sort": {"op": "max", "field": "ord", "order": "descending"},
              "header": {"labels": false}
            }
          },
          "spec": {
            "width": 74,
            "height": 26,
            "mark": {"type": "text", "align": "right", "font": "IBM Plex Mono", "fontSize": 10, "color": "#17181A"},
            "encoding": {
              "x": {"datum": 74, "axis": null, "scale": {"domain": [0, 74]}},
              "text": {"field": "current", "type": "quantitative", "format": ",.0f"}
            }
          }
        },
        {
          "title": "of which recurring",
          "description": "The saving column. A merchant billing in four months or more is a standing cost, and standing costs are the ones where cancelling saves twelve times - so the filled part of the bar is the part worth attacking.",
          "transform": [{"filter": "datum.k === \'s\'"}],
          "bounds": "flush",
          "facet": {
            "row": {
              "field": "cat", "type": "nominal", "title": null,
              "sort": {"op": "max", "field": "ord", "order": "descending"},
              "header": {"labels": false}
            }
          },
          "spec": {
            "width": 130,
            "height": 26,
            "layerNote": "Income is filtered out in the layers rather than in the panel, and the distinction matters. Filtering the panel would drop Salary and Freelance from this facet\'s row domain, leaving twelve rows against the other panels\' fourteen - the alignment breaks again, one column short. Filtering inside the layers leaves the rows in place and empty, which is the honest reading anyway: there is no standing cost to cancel in a salary. It also hands the shared x scale back to Rent, so the spend bars are readable instead of being slivers next to a full-width 43,661.",
            "layer": [
              {
                "description": "The whole category, faint - the ground the recurring part is read against.",
                "transform": [{"filter": "datum.kind !== \'Income\'"}],
                "mark": {"type": "bar", "height": 9, "color": "#E6E0D4", "cornerRadius": 1},
                "encoding": {"x": {"field": "current", "type": "quantitative", "axis": null}}
              },
              {
                "transform": [{"filter": "datum.kind !== \'Income\'"}],
                "mark": {"type": "bar", "height": 9, "color": "#6B4E8A", "cornerRadius": 1},
                "encoding": {
                  "x": {"field": "recur", "type": "quantitative"},
                  "tooltip": [
                    {"field": "cat", "type": "nominal", "title": "Category"},
                    {"field": "current", "type": "quantitative", "title": "Spent this year", "format": ",.2f"},
                    {"field": "recur", "type": "quantitative", "title": "Of which recurring", "format": ",.2f"}
                  ]
                }
              }
            ]
          }
        }
      ]
    }
  ],
  "resolve": {"scale": {"x": "independent", "y": "independent", "color": "independent"}}
}')
          }

                -- ------------------------------------------------------------
                -- The shape of the selection.
                -- ------------------------------------------------------------
                -- Under the table rather than under the whole page. It used to
                -- span all twelve columns, which left the inspector beside a
                -- short chart column and a screen of empty space below it — so
                -- the list of transactions the card is about was the one thing
                -- with nowhere to grow. Inside the chart column the two cards
                -- stack, the inspector runs the height of both, and the chart
                -- is the same width as the table above it.
          container ctnDashDetail (class: 'card ledger-card') {
            container ctnDashDetailHead (class: 'ledger-chart-head') {
              dynamictext txtDashDetailTitle (attribute: DetailTitle, rendermode: H6)
              dynamictext txtDashDetailMeta (attribute: DetailMeta, rendermode: paragraph, class: 'text-muted')
            }
            pluggablewidget 'ledger.widget.web.vegachart.VegaChart' chartDashDetail (
              chartData: DetailData,
              datasetName: 'table',
              chartHeight: 340,
              renderer: 'svg',
              showActions: false,
              spec: '{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "data": {"name": "table"},
  "widthNote": "Matched to the table above it, and measured rather than computed. Arithmetic off the panel widths said 816; the two views then rendered 920 and 877 CSS pixels wide, because each spends a different amount on padding and axis furniture. 859 is 816 plus that 43px difference, and puts both SVGs at 920. They are two cards in one column now, and a column of cards whose contents end at different x reads as a mistake.",
  "width": 859,
  "height": 290,
  "padding": {"left": 18, "top": 6, "right": 10, "bottom": 6},
  "background": null,
  "config": {
    "view": {"stroke": null},
    "axis": {"labelFont": "IBM Plex Mono", "labelFontSize": 9, "labelColor": "#8A8378",
             "domainColor": "#D9D2C6", "tickColor": "#D9D2C6", "gridColor": "#EFEAE0"}
  },
  "mark": {"type": "circle", "size": 42, "opacity": 0.7, "color": "#1B4D4B"},
  "encoding": {
    "x": {"field": "d", "type": "temporal", "axis": {"title": null, "format": "%b %y", "grid": false}},
    "y": {"field": "v", "type": "quantitative",
          "scale": {"zero": false},
          "axis": {"title": "EUR", "titleFontSize": 9, "titleColor": "#8A8378", "format": ",.0f", "grid": true}},
    "tooltip": [
      {"field": "m", "type": "nominal", "title": "Merchant"},
      {"field": "d", "type": "temporal", "title": "Date", "format": "%e %b %Y"},
      {"field": "acc", "type": "nominal", "title": "Account"},
      {"field": "v", "type": "quantitative", "title": "Amount", "format": ",.2f"}
    ]
  }
}')
          }
              }

              -- ----------------------------------------------------------------
              -- The transactions behind the selection.
              -- ----------------------------------------------------------------
              -- A database datasource constrained on the selected category's
              -- name, which the click handler has already written to DetailTitle.
              -- Nothing here takes the context as a datasource *parameter*, so a
              -- click can move the selection without rebuilding the chart —
              -- the same arrangement that keeps the Cashflow matrix from
              -- re-rendering on every cell click.
              --
              -- Before the view carried uncategorised rows this list could not
              -- exist for the one selection that most needed it: 'Needs review'
              -- matched nothing, and the dashboard could count twelve
              -- transactions it had no way to show.
              column colDashInspector (desktopwidth: 3) {
                container ctnDashInspector (class: 'card ledger-inspector') {
                  container ctnDashInspectorHead (class: 'ledger-inspector-head') {
                    dynamictext txtDashInsKicker (content: 'Selected', class: 'ledger-kicker')
                    dynamictext txtDashInsTitle (attribute: DetailTitle, rendermode: H5)
                    dynamictext txtDashInsMeta (attribute: DetailMeta, class: 'ledger-inspector-meta')
                  }
                  listview lvDashLines (
                    datasource: database from Ledger.VTransactionLine
                      where [CategoryName = $currentObject/DetailTitle]
                      sort by TxDate desc,
                    class: 'ledger-inspector-list ledger-inspector-list-tall'
                  ) {
                    template tplDashLine {
                      container ctnDashLine (
                        class: 'ledger-line ledger-line-clickable',
                        onclick: microflow Ledger.ACT_ShowTransaction(Line: $currentObject)
                      ) {
                        container ctnDashLineText (class: 'ledger-line-text') {
                          dynamictext txtDashLineMerchant (attribute: Merchant, class: 'ledger-line-merchant')
                          dynamictext txtDashLineMeta (
                            content: '{1} · {2}',
                            contentparams: [{1} = TxDate format (dateFormat: Custom, customDateFormat: 'd MMM yyyy'), {2} = AccountName],
                            class: 'ledger-line-meta')
                        }
                        dynamictext txtDashLineAmount (
                          content: '{1}€ {2}',
                          contentparams: [{1} = Sign, {2} = AbsAmount format (decimalPrecision: 2, groupDigits: true)],
                          class: 'ledger-line-amount')
                      }
                    }
                  }
                }
              }
            }
          }

        }
      }
    }
  }
}
/

-- Navigation is not written here. It used to be written by four files, each
-- carrying the menu as it stood at that point, so running any one of them on
-- its own silently reverted the menu to an older shape — a trap this project
-- fell into twice. It now has a single owner: 27-navigation.mdl.
