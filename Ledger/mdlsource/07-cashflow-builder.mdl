-- ============================================================================
-- 07 - Cashflow matrix builder
-- ============================================================================
-- Builds the non-persistent rows behind the cashflow DataGrid2.
--
-- The critical rule is that months after the current one are blank, not zero
-- (PROTOTYPE-ANALYSIS §5.3). A zero actual against a full budget reads as
-- maximally under budget, which would paint August-December deep green and
-- report five months of savings that never happened. Every place that could
-- leak a future zero — cell text, cell tint, row totals, the net line and the
-- KPIs — is gated on IsElapsed.
-- ============================================================================

-- MARK: Formatting helpers

/**
 * Month index to the MonthKey stored on Transaction / BudgetOverride.
 *
 * @param $MonthIndex 1-12
 * @returns 'YYYY-MM' for 2026
 */
create or modify microflow Ledger.FMT_MonthKey ($MonthIndex: integer)
returns string as $Key
folder 'Cashflow'
begin
  declare $Key string = '';
  if $MonthIndex < 10 then
    set $Key = '2026-0' + toString($MonthIndex);
  else
    set $Key = '2026-' + toString($MonthIndex);
  end if;
  return $Key;
end;
/

/**
 * Amount as a euro string. Whole euros — the matrix is a scanning view and
 * cents are noise at this density.
 *
 * @param $Amount Value to format
 * @returns e.g. '€ 1,480' or '-€ 612'
 */
create or modify microflow Ledger.FMT_Euro ($Amount: decimal)
returns string as $Text
folder 'Cashflow'
begin
  declare $Text string = '';
  if $Amount < 0 then
    set $Text = '-€ ' + formatDecimal(abs($Amount), '#,##0');
  else
    set $Text = '€ ' + formatDecimal($Amount, '#,##0');
  end if;
  return $Text;
end;
/

/**
 * Variance as a signed euro string. Positive is favourable — under budget on
 * an expense, over budget on income.
 *
 * @param $Amount Favourable-positive variance
 * @returns e.g. '+€ 120'
 */
create or modify microflow Ledger.FMT_Variance ($Amount: decimal)
returns string as $Text
folder 'Cashflow'
begin
  declare $Text string = '';
  if $Amount > 0 then
    set $Text = '+€ ' + formatDecimal($Amount, '#,##0');
  else
    if $Amount < 0 then
      set $Text = '-€ ' + formatDecimal(abs($Amount), '#,##0');
    else
      set $Text = '€ 0';
    end if;
  end if;
  return $Text;
end;
/

-- MARK: Figures

/**
 * Budget for one category in one month: an override when present, otherwise
 * the category baseline.
 *
 * @param $Category Category to look up
 * @param $MonthKey 'YYYY-MM'
 * @returns Budget amount
 */
create or modify microflow Ledger.CALC_Budget ($Category: Ledger.Category, $MonthKey: string)
returns decimal as $Budget
folder 'Cashflow'
begin
  declare $Budget decimal = 0;
  retrieve $Override from Ledger.BudgetOverride
    where Ledger.BudgetOverride_Category = $Category and MonthKey = $MonthKey
    limit 1;
  if $Override != empty then
    set $Budget = $Override/Amount;
  else
    set $Budget = $Category/BaselineBudget;
  end if;
  return $Budget;
end;
/

/**
 * Actual spend or income for one category in one month.
 *
 * Mirrors are excluded: an internal transfer books on both accounts, and
 * counting both would double the category total.
 *
 * @param $Category Category to total
 * @param $MonthKey 'YYYY-MM'
 * @returns Sum of transaction amounts
 */
create or modify microflow Ledger.CALC_Actual ($Category: Ledger.Category, $MonthKey: string)
returns decimal as $Total
folder 'Cashflow'
begin
  retrieve $TxList from Ledger.Transaction
    where Ledger.Transaction_Category = $Category
      and MonthKey = $MonthKey
      and IsMirror = false;
  $Total = sum($TxList.Amount);
  return $Total;
end;
/

/**
 * Heatmap band for a cell.
 *
 * The prototype computed a continuous alpha; Mendix gives class names, so the
 * ratio is bucketed into five levels either side. The 2% dead band is carried
 * over so cells that are essentially on budget stay untinted.
 *
 * @param $Unfavourable Signed so that positive is bad (over on expense, under on income)
 * @param $Budget Budget for the cell; zero disables tinting
 * @returns '', 'over-1'..'over-5' or 'under-1'..'under-5'
 */
create or modify microflow Ledger.CALC_Band ($Unfavourable: decimal, $Budget: decimal)
returns string as $Band
folder 'Cashflow'
begin
  declare $Band string = '';
  declare $Rel decimal = 0;
  declare $Ratio decimal = 0;
  declare $Level integer = 1;

  if $Budget = 0 then
    return '';
  end if;

  set $Rel = abs($Unfavourable) div $Budget;

  @annotation 'Dead band: within 2% of budget is not worth tinting'
  if $Rel < 0.02 then
    return '';
  end if;

  set $Ratio = $Rel div 0.35;
  if $Ratio > 1 then
    set $Ratio = 1;
  end if;

  if $Ratio > 0.8 then
    set $Level = 5;
  else
    if $Ratio > 0.6 then
      set $Level = 4;
    else
      if $Ratio > 0.4 then
        set $Level = 3;
      else
        if $Ratio > 0.2 then
          set $Level = 2;
        else
          set $Level = 1;
        end if;
      end if;
    end if;
  end if;

  if $Unfavourable > 0 then
    set $Band = 'over-' + toString($Level);
  else
    set $Band = 'under-' + toString($Level);
  end if;
  return $Band;
end;
/

-- MARK: Cell rendering

/**
 * The text a cell shows, for the current mode.
 *
 * Budget mode shows every month, because a budget exists for months that have
 * not happened — that is the whole point of choosing a calendar year. Actual
 * and Variance blank out future months.
 *
 * @param $Mode Current report mode
 * @param $Actual Actual for the cell
 * @param $Budget Budget for the cell
 * @param $IsIncome True when the row belongs to an income group
 * @param $IsElapsed False for months that have not happened yet
 * @returns Formatted cell text, empty for a future month
 */
create or modify microflow Ledger.CALC_CellText (
  $Mode: enum Ledger.ReportMode,
  $Actual: decimal,
  $Budget: decimal,
  $IsIncome: boolean,
  $IsElapsed: boolean
)
returns string as $Text
folder 'Cashflow'
begin
  declare $Text string = '';
  declare $Favourable decimal = 0;

  if $Mode = Ledger.ReportMode.Budget then
    $BudgetText = call microflow Ledger.FMT_Euro (Amount = $Budget);
    set $Text = $BudgetText;
    return $Text;
  end if;

  @annotation 'Future months are blank, never zero'
  if not($IsElapsed) then
    return '';
  end if;

  if $Mode = Ledger.ReportMode.Actual then
    $ActualText = call microflow Ledger.FMT_Euro (Amount = $Actual);
    set $Text = $ActualText;
  else
    set $Favourable = if $IsIncome then $Actual - $Budget else $Budget - $Actual;
    $VarText = call microflow Ledger.FMT_Variance (Amount = $Favourable);
    set $Text = $VarText;
  end if;
  return $Text;
end;
/

/**
 * The heatmap band a cell shows, for the current mode.
 *
 * Budget mode is never tinted — there is nothing to compare a budget against.
 *
 * @param $Mode Current report mode
 * @param $Actual Actual for the cell
 * @param $Budget Budget for the cell
 * @param $IsIncome True when the row belongs to an income group
 * @param $IsElapsed False for months that have not happened yet
 * @returns Band class suffix, empty when untinted
 */
create or modify microflow Ledger.CALC_CellBand (
  $Mode: enum Ledger.ReportMode,
  $Actual: decimal,
  $Budget: decimal,
  $IsIncome: boolean,
  $IsElapsed: boolean
)
returns string as $Band
folder 'Cashflow'
begin
  declare $Band string = '';
  declare $Unfavourable decimal = 0;

  if $Mode = Ledger.ReportMode.Budget then
    return '';
  end if;

  @annotation 'A future month has no actual, so nothing to tint'
  if not($IsElapsed) then
    return '';
  end if;

  set $Unfavourable = if $IsIncome then $Budget - $Actual else $Actual - $Budget;
  $Computed = call microflow Ledger.CALC_Band (Unfavourable = $Unfavourable, Budget = $Budget);
  set $Band = $Computed;
  return $Band;
end;
/

/**
 * Writes a computed cell into the right month attribute.
 *
 * Mendix cannot address an attribute by name, so this twelve-branch assignment
 * is the price of a fixed-width matrix. It exists once rather than once per
 * row type.
 *
 * @param $Row Row to write into
 * @param $MonthIndex 1-12
 * @param $Text Cell text
 * @param $Band Cell band
 * @returns true
 */
create or modify microflow Ledger.SET_RowMonth (
  $Row: Ledger.CashflowRow,
  $MonthIndex: integer,
  $Text: string,
  $Band: string
)
returns boolean as $Done
folder 'Cashflow'
begin
  declare $Done boolean = true;
  if $MonthIndex = 1 then change $Row (M01Text = $Text, M01Band = $Band); end if;
  if $MonthIndex = 2 then change $Row (M02Text = $Text, M02Band = $Band); end if;
  if $MonthIndex = 3 then change $Row (M03Text = $Text, M03Band = $Band); end if;
  if $MonthIndex = 4 then change $Row (M04Text = $Text, M04Band = $Band); end if;
  if $MonthIndex = 5 then change $Row (M05Text = $Text, M05Band = $Band); end if;
  if $MonthIndex = 6 then change $Row (M06Text = $Text, M06Band = $Band); end if;
  if $MonthIndex = 7 then change $Row (M07Text = $Text, M07Band = $Band); end if;
  if $MonthIndex = 8 then change $Row (M08Text = $Text, M08Band = $Band); end if;
  if $MonthIndex = 9 then change $Row (M09Text = $Text, M09Band = $Band); end if;
  if $MonthIndex = 10 then change $Row (M10Text = $Text, M10Band = $Band); end if;
  if $MonthIndex = 11 then change $Row (M11Text = $Text, M11Band = $Band); end if;
  if $MonthIndex = 12 then change $Row (M12Text = $Text, M12Band = $Band); end if;
  return $Done;
end;
/
