-- ============================================================================
-- 28a - CSV paste, into the loader table
-- ============================================================================
-- The loader screen could land a sample batch and nothing else. This is the
-- other half: paste the text of a statement export into a box and have it
-- become rows.
--
-- WHY THIS IS JAVA. The rest of this project is MDL, and the boundary has been
-- Java only where MDL cannot reach — OQL statements in 28, and now this. A
-- Mendix microflow expression has no split, no regular expressions, and no way
-- to walk a string other than find() and substring() in a loop. CSV is not a
-- line-and-comma format: a field may be quoted, a quoted field may contain the
-- delimiter, a doubled quote is a literal quote, and a quoted field may contain
-- a newline, so even *finding the lines* requires knowing whether you are
-- inside quotes. That is a character state machine. Written as a microflow it
-- would be several hundred activities that nobody could read and nothing could
-- check; written as Java it is one loop and it is correct.
--
-- WHAT IT DELIBERATELY DOES NOT DO. It does not resolve accounts or categories,
-- parse the date, or decide anything about a row's meaning. Everything lands as
-- text and the existing statements in 28 do the rest — that is the entire point
-- of a loader table, and a parser that started making judgements would be a
-- second place where an import can go wrong quietly.
-- ============================================================================

/**
 * Parse pasted CSV text into ImportRow records under one batch.
 *
 * The format is deliberately forgiving, because the text is arriving from a
 * clipboard rather than from a contract:
 *
 *   Delimiter    comma, semicolon or tab, detected from the first line, or
 *                forced by passing one character (or the word 'tab')
 *   Quotes       standard CSV: "..." with "" for a literal quote, and a
 *                newline inside quotes stays inside the field
 *   Header       detected by looking for a known column name in the first row.
 *                When present, columns are mapped by name and may be in any
 *                order; when absent, the order is
 *                date, merchant, description, amount, account, category
 *   Names        English and Dutch headers both map — date/datum,
 *                amount/bedrag, account/rekening, category/categorie, and so on
 *   Amounts      currency symbols and spaces are stripped, and both decimal
 *                conventions are read: 1.234,56 and 1,234.56 both give 1234.56
 *   Blank lines  skipped, wherever they are
 *
 * A line that cannot be read into columns still lands, flagged, carrying the
 * reason and the line itself. That is the loader table doing its job: a parse
 * failure belongs in the reject list beside the validation failures, not in an
 * error dialog that loses the other ninety-nine rows.
 *
 * THE SIGN IS DISCARDED. ImportRow.Amount is always positive here, because
 * direction comes from the category everywhere else in this app. A statement
 * export writing -61.20 for a payment lands as 61.20, and Groceries makes it a
 * payment. This is the one place a paste could surprise someone, so it is
 * stated on the screen as well.
 *
 * @param Csv The pasted text
 * @param Batch Batch key to land under; existing rows are not touched
 * @param Delimiter One character, the word 'tab', or empty to detect it
 * @returns Rows landed, including the ones flagged as unparseable
 */
create or replace java action Ledger.CSV_LandImportRows (
  Csv: string,
  Batch: string,
  Delimiter: string
)
returns integer
as $$
if (Csv == null || Csv.trim().isEmpty()) {
    return 0L;
}

final int MAX_ROWS = 5000;

String text = Csv;
if (!text.isEmpty() && text.charAt(0) == '﻿') {
    text = text.substring(1);
}

// --- delimiter -----------------------------------------------------------
char delim;
String forced = (Delimiter == null ? "" : Delimiter.trim());
if (forced.equalsIgnoreCase("tab")) {
    delim = '\t';
} else if (forced.length() == 1) {
    delim = forced.charAt(0);
} else {
    // Count candidates on the first line only, outside quotes. A semicolon
    // export full of commas inside quoted descriptions would otherwise look
    // comma-separated.
    int commas = 0, semis = 0, tabs = 0;
    boolean q = false;
    for (int i = 0; i < text.length(); i++) {
        char ch = text.charAt(i);
        if (ch == '"') { q = !q; continue; }
        if (!q && (ch == '\n' || ch == '\r')) break;
        if (q) continue;
        if (ch == ',') commas++;
        else if (ch == ';') semis++;
        else if (ch == '\t') tabs++;
    }
    if (semis > commas && semis >= tabs) delim = ';';
    else if (tabs > commas && tabs > semis) delim = '\t';
    else delim = ',';
}

// --- records -------------------------------------------------------------
// One pass over the characters. inQuotes is the whole reason this is not a
// split on newline followed by a split on the delimiter.
java.util.List<java.util.List<String>> records = new java.util.ArrayList<java.util.List<String>>();
java.util.List<String> row = new java.util.ArrayList<String>();
StringBuilder cell = new StringBuilder();
boolean inQuotes = false;

for (int i = 0; i < text.length(); i++) {
    char ch = text.charAt(i);
    if (inQuotes) {
        if (ch == '"') {
            if (i + 1 < text.length() && text.charAt(i + 1) == '"') { cell.append('"'); i++; }
            else inQuotes = false;
        } else {
            cell.append(ch);
        }
        continue;
    }
    if (ch == '"') { inQuotes = true; continue; }
    if (ch == delim) { row.add(cell.toString()); cell.setLength(0); continue; }
    if (ch == '\r' || ch == '\n') {
        if (ch == '\r' && i + 1 < text.length() && text.charAt(i + 1) == '\n') i++;
        row.add(cell.toString());
        cell.setLength(0);
        records.add(row);
        row = new java.util.ArrayList<String>();
        continue;
    }
    cell.append(ch);
}
row.add(cell.toString());
records.add(row);

// Blank lines anywhere, including a trailing newline, are not rows.
java.util.List<java.util.List<String>> data = new java.util.ArrayList<java.util.List<String>>();
for (java.util.List<String> r : records) {
    for (String v : r) {
        if (v != null && !v.trim().isEmpty()) { data.add(r); break; }
    }
}
if (data.isEmpty()) {
    return 0L;
}

// --- column map ----------------------------------------------------------
java.util.function.Function<String, String> norm = v ->
    v == null ? "" : v.trim().toLowerCase().replaceAll("[^a-z0-9]", "");

int iDate = 0, iMerchant = 1, iDesc = 2, iAmount = 3, iAccount = 4, iCategory = 5;
int firstDataRow = 0;

java.util.List<String> head = data.get(0);
boolean looksLikeHeader = false;
for (String v : head) {
    String n = norm.apply(v);
    if (n.equals("date") || n.equals("datum") || n.equals("txdate")
        || n.equals("transactiondate") || n.equals("boekingsdatum")
        || n.equals("merchant") || n.equals("payee") || n.equals("counterparty")
        || n.equals("amount") || n.equals("bedrag")
        || n.equals("account") || n.equals("rekening")
        || n.equals("category") || n.equals("categorie")
        || n.equals("description") || n.equals("omschrijving")) {
        looksLikeHeader = true;
        break;
    }
}

if (looksLikeHeader) {
    iDate = -1; iMerchant = -1; iDesc = -1; iAmount = -1; iAccount = -1; iCategory = -1;
    for (int i = 0; i < head.size(); i++) {
        String n = norm.apply(head.get(i));
        if (iDate < 0 && (n.equals("date") || n.equals("datum") || n.equals("txdate")
            || n.equals("txdatetext") || n.equals("transactiondate") || n.equals("boekingsdatum"))) {
            iDate = i;
        } else if (iMerchant < 0 && (n.equals("merchant") || n.equals("payee")
            || n.equals("counterparty") || n.equals("naam") || n.equals("name")
            || n.equals("tegenrekening"))) {
            iMerchant = i;
        } else if (iDesc < 0 && (n.equals("description") || n.equals("omschrijving")
            || n.equals("mededelingen") || n.equals("memo") || n.equals("notes"))) {
            iDesc = i;
        } else if (iAmount < 0 && (n.equals("amount") || n.equals("bedrag") || n.equals("value"))) {
            iAmount = i;
        } else if (iAccount < 0 && (n.equals("account") || n.equals("accountname")
            || n.equals("rekening") || n.equals("iban"))) {
            iAccount = i;
        } else if (iCategory < 0 && (n.equals("category") || n.equals("categoryname")
            || n.equals("categorie"))) {
            iCategory = i;
        }
    }
    firstDataRow = 1;
}

// --- helpers -------------------------------------------------------------
java.util.function.BiFunction<java.util.List<String>, Integer, String> at = (rec, idx) ->
    (idx == null || idx < 0 || idx >= rec.size() || rec.get(idx) == null)
        ? "" : rec.get(idx).trim();

java.util.function.BiFunction<String, Integer, String> clip = (v, n) ->
    v == null ? "" : (v.length() <= n ? v : v.substring(0, n));

// Both decimal conventions, and neither is guessed from a locale: whichever
// separator appears last is the decimal one, because that is true in both.
java.util.function.Function<String, java.math.BigDecimal> money = raw -> {
    if (raw == null) return null;
    StringBuilder digits = new StringBuilder();
    for (int i = 0; i < raw.length(); i++) {
        char ch = raw.charAt(i);
        if ((ch >= '0' && ch <= '9') || ch == '.' || ch == ',') digits.append(ch);
    }
    String t = digits.toString();
    if (t.isEmpty()) return null;

    int lastDot = t.lastIndexOf('.');
    int lastComma = t.lastIndexOf(',');
    if (lastDot >= 0 && lastComma >= 0) {
        if (lastComma > lastDot) t = t.replace(".", "").replace(',', '.');
        else t = t.replace(",", "");
    } else if (lastComma >= 0) {
        // A lone comma is a decimal point when it has one or two digits behind
        // it (61,2 / 61,20) and a thousands separator otherwise (1,234).
        int after = t.length() - lastComma - 1;
        if (after == 1 || after == 2) t = t.replace(',', '.');
        else t = t.replace(",", "");
    } else if (lastDot >= 0 && t.indexOf('.') != lastDot) {
        // 1.234.56 — every dot but the last is grouping.
        t = t.substring(0, lastDot).replace(".", "") + "." + t.substring(lastDot + 1);
    }

    try {
        return new java.math.BigDecimal(t).abs();
    } catch (NumberFormatException e) {
        return null;
    }
};

// --- land ----------------------------------------------------------------
com.mendix.systemwideinterfaces.core.IContext ctx = getContext();
java.util.List<com.mendix.systemwideinterfaces.core.IMendixObject> landed =
    new java.util.ArrayList<com.mendix.systemwideinterfaces.core.IMendixObject>();
long rowNo = 0;
int ignored = 0;

for (int r = firstDataRow; r < data.size(); r++) {
    if (landed.size() >= MAX_ROWS) { ignored = data.size() - r; break; }
    java.util.List<String> rec = data.get(r);
    rowNo++;

    com.mendix.systemwideinterfaces.core.IMendixObject o =
        com.mendix.core.Core.instantiate(ctx, "Ledger.ImportRow");
    o.setValue(ctx, "Batch", Batch);
    o.setValue(ctx, "RowNo", Long.valueOf(rowNo));
    o.setValue(ctx, "TxDateText", clip.apply(at.apply(rec, iDate), 30));
    o.setValue(ctx, "Merchant", clip.apply(at.apply(rec, iMerchant), 200));
    o.setValue(ctx, "Description", clip.apply(at.apply(rec, iDesc), 500));
    o.setValue(ctx, "AccountName", clip.apply(at.apply(rec, iAccount), 100));
    o.setValue(ctx, "CategoryName", clip.apply(at.apply(rec, iCategory), 100));

    String why = null;
    java.math.BigDecimal amount = null;
    if (rec.size() < 2) {
        why = "Expected at least 2 columns, found " + rec.size();
    } else if (iAmount < 0) {
        why = "No amount column found in the header";
    } else {
        amount = money.apply(at.apply(rec, iAmount));
        if (amount == null) {
            why = "Amount could not be read from '" + at.apply(rec, iAmount) + "'";
        }
    }

    if (why == null) {
        o.setValue(ctx, "Amount", amount);
        o.setValue(ctx, "IsValid", Boolean.TRUE);
        o.setValue(ctx, "HasParseError", Boolean.FALSE);
        o.setValue(ctx, "Problem", "");
    } else {
        StringBuilder line = new StringBuilder();
        for (int c = 0; c < rec.size(); c++) {
            if (c > 0) line.append(delim);
            line.append(rec.get(c));
        }
        o.setValue(ctx, "Amount", java.math.BigDecimal.ZERO);
        o.setValue(ctx, "IsValid", Boolean.FALSE);
        o.setValue(ctx, "HasParseError", Boolean.TRUE);
        o.setValue(ctx, "Problem", clip.apply(why + " — " + line.toString(), 200));
    }

    landed.add(o);
}

// A cap that says nothing is a cap that reads as "all of it imported".
if (ignored > 0) {
    com.mendix.systemwideinterfaces.core.IMendixObject note =
        com.mendix.core.Core.instantiate(ctx, "Ledger.ImportRow");
    note.setValue(ctx, "Batch", Batch);
    note.setValue(ctx, "RowNo", Long.valueOf(rowNo + 1));
    note.setValue(ctx, "TxDateText", "");
    note.setValue(ctx, "Merchant", "");
    note.setValue(ctx, "Description", "");
    note.setValue(ctx, "AccountName", "");
    note.setValue(ctx, "CategoryName", "");
    note.setValue(ctx, "Amount", java.math.BigDecimal.ZERO);
    note.setValue(ctx, "IsValid", Boolean.FALSE);
    note.setValue(ctx, "HasParseError", Boolean.TRUE);
    note.setValue(ctx, "Problem", clip.apply(
        ignored + " further line(s) were not read: this paste is capped at " + MAX_ROWS + " rows", 200));
    landed.add(note);
}

if (!landed.isEmpty()) {
    com.mendix.core.Core.commit(ctx, landed);
}

com.mendix.core.Core.getLogger("Import").info(
    "CSV_LandImportRows: landed " + landed.size() + " row(s) into batch '" + Batch
    + "' (delimiter '" + delim + "', header " + looksLikeHeader + ")");

return Long.valueOf(landed.size());
$$;
/
