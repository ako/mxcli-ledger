-- ============================================================================
-- 25 - Insights: the payloads
-- ============================================================================
-- Five datasets, six charts. The scatter and the miscategorisation view read
-- the same rows — one is "every expense over time, coloured by category" and
-- the other is "the same points, with the ones unlike their neighbours called
-- out" — so the difference between them lives in the spec, not here. That is
-- the split this page is built to demonstrate: the model emits facts, the spec
-- decides what they mean.
--
-- Every builder takes its rows as a list parameter rather than retrieving.
-- DS_InsightsContext does the retrieving, once, so the page costs one query per
-- view instead of one per chart (docs/observability.md).
--
-- Amounts go through formatDecimal('0.00'): a Decimal stringifies with a long
-- tail and small values come out in scientific notation (FINDINGS 19), neither
-- of which is valid JSON.
-- ============================================================================

/**
 * Everything the Insights page binds to: the filter the reader has set, and the
 * six payloads that follow from it.
 *
 * Filter and payloads live on one object rather than two so a control can write
 * an attribute and one `change ... refresh` re-renders every chart. Splitting
 * them would mean a nested data view whose inner datasource has to be
 * persuaded to re-run, which is the fight FINDINGS 68 describes.
 *
 * The category and account filters are associations rather than name strings:
 * a combobox needs something to enumerate, and matching on a display name is
 * only correct until someone renames one. Empty means no filter.
 */
create or modify non-persistent entity Ledger.InsightsContext (
  /** Signed monthly totals per category, both years */
  StreamData: string,
  /** One row per expense transaction — feeds the scatter and the outlier view */
  TxData: string,
  /** Spend per calendar day */
  CalendarData: string,
  /** Recurring merchants with a projected annual cost */
  SavingsData: string,
  /** Per-category totals for the same window in both years */
  YoYData: string,
  /** e.g. 'Jan-Aug 2026 against Jan-Aug 2025' */
  WindowText: string(160),
  /** What the filter currently selects, in words */
  FilterText: string(200),
  /** Start of the period, inclusive */
  FromDate: datetime,
  /** End of the period, inclusive */
  ToDate: datetime,
  /** The clicked mark's datum, as JSON, written by the chart widget */
  SelectedPoint: string,
  /** Transactions behind the clicked day */
  DetailData: string,
  /** The clicked day */
  DetailTitle: string(60),
  /** e.g. '7 transactions · € 143.20' */
  DetailMeta: string(120)
);
/

create or modify association Ledger.InsightsContext_Category
  from Ledger.InsightsContext to Ledger.Category
  type Reference;
/

create or modify association Ledger.InsightsContext_Account
  from Ledger.InsightsContext to Ledger.Account
  type Reference;
/

/**
 * Signed monthly totals: income positive, expense negative.
 *
 * The sign is applied here rather than in the spec because it is a fact about
 * the row, not a rendering choice — an expense is money leaving. A stacked area
 * over mixed signs then puts income above the axis and spend below with no
 * further instruction.
 *
 * @param $Rows VMonthCategory
 * @returns JSON array
 */
create or modify microflow Ledger.BUILD_StreamData (
  $Rows: list of Ledger.VMonthCategory
)
returns string as $Json
folder 'Insights'
begin
  declare $Json string = '';
  declare $Sep string = '';
  declare $Month string = '';

  loop $R in $Rows
  begin
    @annotation 'An ISO first-of-month so Vega-Lite reads the axis as time rather than as thirteen unrelated labels'
    if $R/MonthIndex < 10 then
      set $Month = toString($R/Yr) + '-0' + toString($R/MonthIndex) + '-01';
    else
      set $Month = toString($R/Yr) + '-' + toString($R/MonthIndex) + '-01';
    end if;

    set $Json = $Json + $Sep
      + '{"t":"' + $Month + '"'
      + ',"cat":"' + $R/CategoryName + '"'
      + ',"grp":"' + $R/GroupName + '"'
      + ',"kind":"' + $R/GroupTypeName + '"'
      + ',"color":"' + $R/ColorHex + '"'
      + ',"v":' + formatDecimal($R/Signed, '0.00') + '}';
    set $Sep = ',';
  end loop;

  return '[' + $Json + ']';
end;
/

/**
 * One row per expense transaction.
 *
 * Income is excluded: a salary is an order of magnitude above every expense
 * and would flatten the whole scatter into a band at the bottom. Filtered on
 * GroupTypeName rather than on the group's display name.
 *
 * @param $Rows VTransactionLine
 * @returns JSON array
 */
create or modify microflow Ledger.BUILD_TxData (
  $Rows: list of Ledger.VTransactionLine
)
returns string as $Json
folder 'Insights'
begin
  declare $Json string = '';
  declare $Sep string = '';

  loop $R in $Rows
  begin
    set $Json = $Json + $Sep
      + '{"d":"' + formatDateTime($R/TxDate, 'yyyy-MM-dd') + '"'
      + ',"cat":"' + $R/CategoryName + '"'
      + ',"grp":"' + $R/GroupName + '"'
      + ',"m":"' + $R/Merchant + '"'
      + ',"v":' + formatDecimal($R/Amount, '0.00') + '}';
    set $Sep = ',';
  end loop;

  return '[' + $Json + ']';
end;
/

/**
 * Spend per calendar day.
 *
 * @param $Rows VDaySpend
 * @returns JSON array
 */
create or modify microflow Ledger.BUILD_CalendarData (
  $Rows: list of Ledger.VDaySpend
)
returns string as $Json
folder 'Insights'
begin
  declare $Json string = '';
  declare $Sep string = '';

  loop $R in $Rows
  begin
    @annotation 'The date is carried twice on purpose. `d` is the temporal field the chart encodes, and Vega parses it to epoch milliseconds - a click handler reading it back gets 1735689600000, not a date. `day` is the same value as a plain string that no encoding parses, which is what the click contract is built on (FINDINGS 92).'
    set $Json = $Json + $Sep
      + '{"d":"' + formatDateTime($R/TxDate, 'yyyy-MM-dd') + '"'
      + ',"day":"' + formatDateTime($R/TxDate, 'yyyy-MM-dd') + '"'
      + ',"v":' + formatDecimal($R/Total, '0.00')
      + ',"n":' + toString($R/TxCount) + '}';
    set $Sep = ',';
  end loop;

  return '[' + $Json + ']';
end;
/

/**
 * Recurring merchants, with what they cost over a year.
 *
 * A merchant that bills in most months is a standing cost, and standing costs
 * are the ones worth attacking — cancelling one saves twelve times. A single
 * large purchase is not a saving opportunity however big it was, so anything
 * appearing in fewer than four months is dropped.
 *
 * The projection is the monthly average times twelve rather than the raw total,
 * because the current year is partial: comparing eight months of one merchant
 * against twelve of another would rank them wrongly.
 *
 * Grouped in a single pass over rows sorted by merchant, which is the only
 * grouping MDL affords — there is no map, and a nested loop over every merchant
 * would be quadratic. The pass flushes when the key changes and once more at
 * the end, which is the part that is easy to get wrong.
 *
 * **This is the one builder that keeps its grouping**, and the reason is worth
 * stating because it is the boundary of what a view entity can do. MonthsActive
 * is a count of distinct months *within the selected period*, so the aggregate
 * depends on a window the reader chooses at runtime — and a view entity takes
 * no parameters. Precomputing it in OQL would silently pin the recurrence
 * signal to the whole year and make the period control a lie. The rows arrive
 * filtered by the database now, so what is left here is the grouping alone.
 *
 * @param $Rows VMerchantMonth, already constrained to the period, sorted by Merchant
 * @returns JSON array
 */
create or modify microflow Ledger.BUILD_SavingsData (
  $Rows: list of Ledger.VMerchantMonth
)
returns string as $Json
folder 'Insights'
begin
  declare $Json string = '';
  declare $Sep string = '';
  declare $CurMerchant string = '';
  declare $CurCategory string = '';
  declare $CurTotal decimal = 0;
  declare $CurMonths integer = 0;
  declare $CurTx integer = 0;
  declare $CurLastMonth integer = 0;
  declare $Projected decimal = 0;

  loop $R in $Rows
  begin
    @annotation 'Key change: flush the merchant just finished before starting the next. Every row reaching here is already in the period, in the year, on the selected account and category, and not a savings transfer - the retrieve constrained all of that. The savings-transfer exclusion matters: money moved to your own savings account is booked as an expense everywhere else in this app, correctly, and is wrong here because this chart ranks costs by what cancelling them would save. It was the second-largest row before that exclusion, at a projected EUR 8,087.'
    if $R/Merchant != $CurMerchant then
      if $CurMonths >= 4 then
        set $Projected = round(($CurTotal div $CurMonths) * 12, 2);
        set $Json = $Json + $Sep
          + '{"m":"' + $CurMerchant + '"'
          + ',"cat":"' + $CurCategory + '"'
          + ',"months":' + toString($CurMonths)
          + ',"tx":' + toString($CurTx)
          + ',"spent":' + formatDecimal($CurTotal, '0.00')
          + ',"year":' + formatDecimal($Projected, '0.00') + '}';
        set $Sep = ',';
      end if;
      set $CurMerchant = $R/Merchant;
      set $CurCategory = $R/CategoryName;
      set $CurTotal = 0;
      set $CurMonths = 0;
      set $CurTx = 0;
      set $CurLastMonth = 0;
    end if;

    set $CurTotal = $CurTotal + $R/Total;
    set $CurTx = $CurTx + $R/TxCount;

    @annotation 'Distinct months, not rows. The view now carries an account, so one merchant billing two cards in March is two rows and one month — counting rows would inflate the recurrence signal and, through it, the annual projection.'
    if $R/MonthIndex != $CurLastMonth then
      set $CurMonths = $CurMonths + 1;
      set $CurLastMonth = $R/MonthIndex;
    end if;
  end loop;

  @annotation 'The last merchant has no successor to trigger its flush'
  if $CurMonths >= 4 then
    set $Projected = round(($CurTotal div $CurMonths) * 12, 2);
    set $Json = $Json + $Sep
      + '{"m":"' + $CurMerchant + '"'
      + ',"cat":"' + $CurCategory + '"'
      + ',"months":' + toString($CurMonths)
      + ',"tx":' + toString($CurTx)
      + ',"spent":' + formatDecimal($CurTotal, '0.00')
      + ',"year":' + formatDecimal($Projected, '0.00') + '}';
  end if;

  return '[' + $Json + ']';
end;
/

/**
 * Each category against the same months of last year.
 *
 * This used to be the most expensive microflow on the page: an outer pass per
 * distinct category, an inner pass over every row to total it, and a delimited
 * string standing in for the set of categories already seen — quadratic, and
 * knowingly so. It is now a Vega-style emitter over Ledger.VYoY, which does the
 * comparison in one grouped scan with conditional aggregation and derives its
 * own month window from the data.
 *
 * The rows arrive filtered and at the right grain: the caller constrains on
 * Grain, which is 'all' when no account is selected and 'account' when one is.
 *
 * @param $Rows VYoY, already constrained to one grain
 * @returns JSON array
 */
create or modify microflow Ledger.BUILD_YoYData (
  $Rows: list of Ledger.VYoY
)
returns string as $Json
folder 'Insights'
begin
  declare $Json string = '';
  declare $Sep string = '';

  loop $R in $Rows
  begin
    set $Json = $Json + $Sep
      + '{"cat":"' + $R/CategoryName + '"'
      + ',"grp":"' + $R/GroupName + '"'
      + ',"kind":"' + $R/GroupTypeName + '"'
      + ',"prior":' + formatDecimal($R/PriorTotal, '0.00')
      + ',"current":' + formatDecimal($R/CurTotal, '0.00')
      + ',"delta":' + formatDecimal($R/Delta, '0.00') + '}';
    set $Sep = ',';
  end loop;

  return '[' + $Json + ']';
end;
/

/**
 * Recomputes every payload from the filter currently on the context.
 *
 * Split from DS_InsightsContext so a control can call it directly: the four
 * retrieves and the five builders are the same either way, and the only
 * difference between first render and a filter change is who created the
 * object. `change ... refresh` at the end is what re-renders the charts — the
 * widgets are bound to attributes, and an attribute that changes redraws.
 *
 * @param $Context The page context, carrying the filter
 * @returns true
 */
create or modify microflow Ledger.ACT_ApplyInsightsFilter (
  $Context: Ledger.InsightsContext
)
returns boolean as $Done
folder 'Insights'
begin
  declare $Done boolean = true;
  declare $Through integer = 0;
  declare $Year integer = 2026;
  declare $CatName string = '';
  declare $AccName string = '';
  declare $FromKey integer = 0;
  declare $ToKey integer = 0;
  declare $Grain string = 'all';
  declare $Scope string = '';

  @annotation 'Empty association means no filter. Read before the retrieves now, because the retrieves are what apply it.'
  if $Context/Ledger.InsightsContext_Category != empty then
    set $CatName = $Context/Ledger.InsightsContext_Category/Ledger.Category/Name;
  end if;
  if $Context/Ledger.InsightsContext_Account != empty then
    set $AccName = $Context/Ledger.InsightsContext_Account/Ledger.Account/Name;
    set $Grain = 'account';
  end if;

  @annotation 'A month key, year*100+month, so a month-grained row can be range-tested against a day-grained period. The views carry the same key as a column, which is what lets this be an XPath constraint rather than an `if` inside a loop - XPath has no arithmetic, so the key has to exist in the database.'
  set $FromKey = parseInteger(formatDateTime($Context/FromDate, 'yyyy')) * 100
    + parseInteger(formatDateTime($Context/FromDate, 'MM'));
  set $ToKey = parseInteger(formatDateTime($Context/ToDate, 'yyyy')) * 100
    + parseInteger(formatDateTime($Context/ToDate, 'MM'));

  @annotation 'Every filter is in the retrieve. This is the change: the page used to pull every row of five views and discard most of them in MDL, once per chart. An empty filter variable is compared against the empty string in the constraint itself, so one retrieve serves both the filtered and unfiltered case without branching.'
  retrieve $Months from Ledger.VMonthCategory
    where [MonthKey >= $FromKey and MonthKey <= $ToKey
      and ($CatName = '' or CategoryName = $CatName)
      and ($AccName = '' or AccountName = $AccName)]
    sort by CategoryName asc, Yr asc, MonthIndex asc;

  @annotation 'Income is excluded here rather than in the builder: a salary is an order of magnitude above every expense and would flatten the scatter into a band at the bottom.'
  retrieve $Lines from Ledger.VTransactionLine
    where [GroupTypeName = 'Expense'
      and TxDate >= $Context/FromDate and TxDate <= $Context/ToDate
      and ($CatName = '' or CategoryName = $CatName)
      and ($AccName = '' or AccountName = $AccName)]
    sort by TxDate asc;

  retrieve $Days from Ledger.VDaySpend
    where [TxDate >= $Context/FromDate and TxDate <= $Context/ToDate
      and ($CatName = '' or CategoryName = $CatName)
      and ($AccName = '' or AccountName = $AccName)]
    sort by TxDate asc;

  @annotation 'Savings transfers are excluded in the constraint. Cancelling one saves nothing, so it does not belong in a chart that ranks costs by what cancelling them would save.'
  retrieve $Merchants from Ledger.VMerchantMonth
    where [Yr = $Year and MonthKey >= $FromKey and MonthKey <= $ToKey
      and not(CategoryName = 'Savings transfer')
      and ($CatName = '' or CategoryName = $CatName)
      and ($AccName = '' or AccountName = $AccName)]
    sort by Merchant asc, Yr asc, MonthIndex asc;

  @annotation 'Grain picks which aggregation of VYoY to read: one row per category across all accounts, or one per category per account. Both are in the view as a UNION ALL, and the constraint prunes the branch that is not wanted before it touches a table.'
  retrieve $YoYRows from Ledger.VYoY
    where [Grain = $Grain
      and ($CatName = '' or CategoryName = $CatName)
      and ($AccName = '' or AccountName = $AccName)]
    sort by CategoryName asc;

  @annotation 'The only unconstrained retrieve left, and the only one that is not a chart payload: the reporting window is a property of the whole dataset, not of the filter.'
  retrieve $Matrix from Ledger.VMatrixActual sort by SortKey asc;

  $ThroughCalc = call microflow Ledger.CALC_ReportingThrough (Rows = $Matrix);
  set $Through = $ThroughCalc;

  $Stream = call microflow Ledger.BUILD_StreamData (Rows = $Months);
  $Tx = call microflow Ledger.BUILD_TxData (Rows = $Lines);
  $Cal = call microflow Ledger.BUILD_CalendarData (Rows = $Days);
  $Sav = call microflow Ledger.BUILD_SavingsData (Rows = $Merchants);
  $YoY = call microflow Ledger.BUILD_YoYData (Rows = $YoYRows);

  $MonthName = call microflow Ledger.FMT_MonthName (MonthIndex = $Through);

  set $Scope = 'All categories';
  if $CatName != '' then
    set $Scope = $CatName;
  end if;
  if $AccName != '' then
    set $Scope = $Scope + ' · ' + $AccName;
  else
    set $Scope = $Scope + ' · all accounts';
  end if;

  change $Context (
    StreamData = $Stream,
    TxData = $Tx,
    CalendarData = $Cal,
    SavingsData = $Sav,
    YoYData = $YoY,
    WindowText = 'January to ' + $MonthName + ' ' + toString($Year)
      + ' against the same months of ' + toString($Year - 1),
    FilterText = formatDateTime($Context/FromDate, 'd MMM yyyy') + ' to '
      + formatDateTime($Context/ToDate, 'd MMM yyyy') + ' · ' + $Scope
  ) refresh;

  return $Done;
end;
/

/**
 * The Insights page's single datasource.
 *
 * Creates the context with a period covering everything the app holds, then
 * hands straight off to the same microflow a filter change uses. First render
 * and every render after it therefore run identical code — the alternative,
 * building payloads here and again in the action, is two implementations of one
 * thing and they drift.
 *
 * Four retrieves feed six charts. Doing that once rather than per chart is the
 * same reasoning that took the Cashflow page from 2,194 SELECTs to 173.
 *
 * @returns The page's context object
 */
create or modify microflow Ledger.DS_InsightsContext ()
returns Ledger.InsightsContext as $Context
folder 'Insights'
begin
  @annotation 'dateTime() takes literals only, and the seed anchors on 2026 — so the default period opens at the start of the prior year, which is the earliest data that exists.'
  $Context = create Ledger.InsightsContext (
    FromDate = addYears(dateTime(2026, 1, 1), -1),
    ToDate = [%CurrentDateTime%],
    SelectedPoint = '',
    DetailData = '[]',
    DetailMeta = 'Click a day in the calendar above.');

  $Ok = call microflow Ledger.ACT_ApplyInsightsFilter (Context = $Context);

  return $Context;
end;
/

/**
 * Clears the filter back to everything.
 *
 * @param $Context The page context
 * @returns true
 */
create or modify microflow Ledger.ACT_ResetInsightsFilter (
  $Context: Ledger.InsightsContext
)
returns boolean as $Done
folder 'Insights'
begin
  declare $Done boolean = true;

  change $Context (
    FromDate = addYears(dateTime(2026, 1, 1), -1),
    ToDate = [%CurrentDateTime%],
    Ledger.InsightsContext_Category = empty,
    Ledger.InsightsContext_Account = empty);

  $Ok = call microflow Ledger.ACT_ApplyInsightsFilter (Context = $Context);

  return $Done;
end;
/

grant execute on microflow Ledger.BUILD_StreamData to Ledger.User;
/
grant execute on microflow Ledger.BUILD_TxData to Ledger.User;
/
grant execute on microflow Ledger.BUILD_CalendarData to Ledger.User;
/
grant execute on microflow Ledger.BUILD_SavingsData to Ledger.User;
/
grant execute on microflow Ledger.BUILD_YoYData to Ledger.User;
/
grant execute on microflow Ledger.DS_InsightsContext to Ledger.User;
/
grant execute on microflow Ledger.ACT_ApplyInsightsFilter to Ledger.User;
/
grant execute on microflow Ledger.ACT_ResetInsightsFilter to Ledger.User;
/
