-- ============================================================================
-- 24a - The scatter's data, as a published feed
-- ============================================================================
-- Five of the six Insights charts read a JSON string built by a microflow. The
-- scatter does not, and this file is why.
--
-- WHAT MAKES THIS ONE DIFFERENT. Every other payload is an aggregate — a month
-- per category, a day, a merchant — so it is small and stays small however much
-- history exists. The scatter is deliberately not aggregated: it draws one dot
-- per transaction, which is the entire point of it, so its payload grows with
-- the data and nothing about the chart's design will ever stop that. It is the
-- largest payload on the page and the only one whose size is a function of the
-- database rather than of the taxonomy.
--
-- WHY THAT MATTERS MORE THAN IT LOOKS. The builders concatenate JSON in an MDL
-- loop, and that was measured: about 0.4 ms per row once the string is large, so
-- 50,000 rows is roughly twenty seconds of string building before anything is
-- sent. Against that, drawing 50,000 points takes 0.6 s on a canvas renderer.
-- The bottleneck was never the chart.
--
-- A published feed removes the concatenation entirely: the database writes the
-- JSON and the browser fetches it. What it costs is a real API surface, which
-- is the reason this is done for one chart rather than all of them — see the
-- note on the service below.
-- ============================================================================

/**
 * One row per expense transaction, in the shape the scatter draws.
 *
 * The field names are the short ones the spec already uses (d, cat, grp, m, v)
 * rather than the domain's own, because the alternative is renaming them in the
 * spec and the spec is the thing that should not change when the data's route
 * changes. The chart cannot tell whether these rows arrived in an attribute or
 * over HTTP, which is what made the swap safe to make.
 *
 * RowKey exists because OData requires a key and this grain has exactly one
 * natural candidate: the transaction itself. It is an autogenerated id, which
 * MDL-ODATA06 rightly warns against putting in a public contract — an id is not
 * stable across environments. It is acceptable here and only here: this feed is
 * consumed by one chart in the same app, the key is never read by that chart,
 * and it is never published as an identifier anyone is invited to store. A feed
 * meant for an outside consumer would need a business key instead.
 *
 * Income is excluded in the view rather than by the caller, matching what
 * BUILD_TxData did: a salary is an order of magnitude above every expense and
 * would flatten the whole scatter into a band at the bottom.
 */
create or modify view entity Ledger.VScatterFeed (
  RowKey: string(200),
  d: datetime,
  cat: string(200),
  grp: string(200),
  m: string(200),
  v: decimal,
  Yr: integer,
  AccountName: string(200)
) as (
  select
    cast(t.id as string) as RowKey,
    t.TxDate as d,
    cast(c.Name as string) as cat,
    cast(g.Name as string) as grp,
    cast(t.Merchant as string) as m,
    t.Amount as v,
    datepart(YEAR, t.TxDate) as Yr,
    cast(a.Name as string) as AccountName
  from Ledger.Transaction as t
  inner join t/Ledger.Transaction_Category/Ledger.Category as c
  inner join c/Ledger.Category_CategoryGroup/Ledger.CategoryGroup as g
  inner join t/Ledger.Transaction_Account/Ledger.Account as a
  where t.IsMirror = false
    and cast(g.GroupType as string) = 'Expense'
);
/

grant Ledger.User on Ledger.VScatterFeed (read *);
/

/**
 * The feed the scatter fetches.
 *
 * PublishAssociations is deliberately not mentioned. Setting it to No selects
 * the "as an associated object id" representation, which requires the system ID
 * published as the key and fails the build with CE7375 even on a flat view with
 * no associations at all — the mistake FINDINGS 113 recorded and 126 corrects.
 * Omitting it takes the default, "as a link".
 *
 * THIS IS API SURFACE, not a private channel. Anything that can reach the app
 * and satisfy `authentication session` can read every expense transaction in
 * the database, filtered or not. That is a larger promise than an attribute on
 * a page makes, and it is why exactly one chart uses this route: the scatter,
 * whose payload grows without bound. The aggregates stay on attributes, where
 * they cost nothing to secure.
 *
 * Note for whoever moves this off a development machine: this project runs at
 * security level Off, so `authentication session` is inert here and an
 * anonymous request succeeds. It takes effect at Prototype or Production.
 * Testing this endpoint's access control at Off proves nothing about it.
 */
create or modify odata service Ledger.InsightsFeed (
  path: 'odata/insights/v1/',
  version: '1.0.0',
  ODataVersion: OData4,
  namespace: 'Ledger',
  ServiceName: 'InsightsFeed',
  Summary: 'Row-level expense data for the Insights scatter'
)
authentication session
{
  publish entity Ledger.VScatterFeed as 'Expenses' (
    ReadMode: ReadFromDatabase,
    InsertMode: NotSupported,
    UpdateMode: NotSupported,
    DeleteMode: NotSupported
  )
  expose (
    RowKey as 'RowKey' (Filterable, Sortable, key),
    d as 'd' (Filterable, Sortable),
    cat as 'cat' (Filterable, Sortable),
    grp as 'grp' (Filterable, Sortable),
    m as 'm' (Filterable, Sortable),
    v as 'v' (Filterable, Sortable),
    Yr as 'Yr' (Filterable, Sortable),
    AccountName as 'AccountName' (Filterable, Sortable)
  );
};
/

grant access on odata service Ledger.InsightsFeed to Ledger.User;
/
