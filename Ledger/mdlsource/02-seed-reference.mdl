-- ============================================================================
-- 02 - Demo data: reference data
-- ============================================================================
-- Accounts, the two-level taxonomy, known merchants, budget overrides and the
-- categorisation rules.
--
-- Values mirror the prototype (see ../../PROTOTYPE-ANALYSIS.md §1). Two
-- deliberate departures:
--   * The month window is the 2026 calendar year, not the prototype's Feb-Jul.
--   * The rules are real and evaluable. The prototype's compound rule 8
--     ('amount = -700,00 and merchant Spaarrekening') was a display string, not
--     data; it is replaced by a plain merchant-contains rule on 'Spaarrekening'.
-- ============================================================================

/**
 * Creates all reference data: accounts, category groups, categories, known
 * merchants, budget overrides and categorisation rules.
 *
 * Assumes the tables are empty — the caller (Seed_DemoData) guards on that.
 *
 * @returns true when the reference data has been created
 */
create or modify microflow Ledger.Seed_ReferenceData ()
returns boolean as $Done
folder 'Demo data'
begin
  declare $Done boolean = false;

  -- MARK: Accounts

  $AccIng = create Ledger.Account (
    Name = 'ING Betaalrekening',
    IBAN = 'NL21 INGB 0004 5567 21',
    AccountType = Ledger.AccountType.Checking,
    Balance = 4820,
    MonthDelta = 310,
    LastImport = dateTime(2026, 7, 24),
    SortOrder = 1);

  $AccSpaar = create Ledger.Account (
    Name = 'ING Spaarrekening',
    IBAN = 'NL21 INGB 0009 8812 04',
    AccountType = Ledger.AccountType.Savings,
    Balance = 28450,
    MonthDelta = 700,
    LastImport = dateTime(2026, 7, 24),
    SortOrder = 2);

  $AccAbn = create Ledger.Account (
    Name = 'ABN AMRO Creditcard',
    IBAN = '**** 4471',
    AccountType = Ledger.AccountType.Credit,
    Balance = -612,
    MonthDelta = -84,
    LastImport = dateTime(2026, 7, 22),
    SortOrder = 3);

  $AccRev = create Ledger.Account (
    Name = 'Revolut',
    IBAN = 'LT84 3250 0117 4291 06',
    AccountType = Ledger.AccountType.Checking,
    Balance = 340,
    MonthDelta = -55,
    LastImport = dateTime(2026, 7, 19),
    SortOrder = 4);

  commit $AccIng;
  commit $AccSpaar;
  commit $AccAbn;
  commit $AccRev;

  -- MARK: Category groups

  $GrpIncome = create Ledger.CategoryGroup (
    Name = 'Income', GroupType = Ledger.GroupType.Income,
    ColorHex = '#2C6E4A', SortOrder = 1);
  $GrpHousing = create Ledger.CategoryGroup (
    Name = 'Housing', GroupType = Ledger.GroupType.Expense,
    ColorHex = '#1B4D4B', SortOrder = 2);
  $GrpDaily = create Ledger.CategoryGroup (
    Name = 'Daily living', GroupType = Ledger.GroupType.Expense,
    ColorHex = '#8A5A2B', SortOrder = 3);
  $GrpLifestyle = create Ledger.CategoryGroup (
    Name = 'Lifestyle', GroupType = Ledger.GroupType.Expense,
    ColorHex = '#6B4E8A', SortOrder = 4);
  $GrpFinancial = create Ledger.CategoryGroup (
    Name = 'Financial', GroupType = Ledger.GroupType.Expense,
    ColorHex = '#3A4A6B', SortOrder = 5);

  commit $GrpIncome;
  commit $GrpHousing;
  commit $GrpDaily;
  commit $GrpLifestyle;
  commit $GrpFinancial;

  -- MARK: Categories

  $CatSalary = create Ledger.Category (Name = 'Salary', BaselineBudget = 5200, SortOrder = 1);
  change $CatSalary (Ledger.Category_CategoryGroup = $GrpIncome);
  commit $CatSalary;
  $CatFreelance = create Ledger.Category (Name = 'Freelance', BaselineBudget = 900, SortOrder = 2);
  change $CatFreelance (Ledger.Category_CategoryGroup = $GrpIncome);
  commit $CatFreelance;

  $CatRent = create Ledger.Category (Name = 'Rent', BaselineBudget = 1480, SortOrder = 3);
  change $CatRent (Ledger.Category_CategoryGroup = $GrpHousing);
  commit $CatRent;
  $CatUtilities = create Ledger.Category (Name = 'Utilities', BaselineBudget = 210, SortOrder = 4);
  change $CatUtilities (Ledger.Category_CategoryGroup = $GrpHousing);
  commit $CatUtilities;
  $CatInternet = create Ledger.Category (Name = 'Internet & phone', BaselineBudget = 78, SortOrder = 5);
  change $CatInternet (Ledger.Category_CategoryGroup = $GrpHousing);
  commit $CatInternet;

  $CatGroceries = create Ledger.Category (Name = 'Groceries', BaselineBudget = 620, SortOrder = 6);
  change $CatGroceries (Ledger.Category_CategoryGroup = $GrpDaily);
  commit $CatGroceries;
  $CatRestaurants = create Ledger.Category (Name = 'Restaurants & cafes', BaselineBudget = 240, SortOrder = 7);
  change $CatRestaurants (Ledger.Category_CategoryGroup = $GrpDaily);
  commit $CatRestaurants;
  $CatTransport = create Ledger.Category (Name = 'Transport', BaselineBudget = 190, SortOrder = 8);
  change $CatTransport (Ledger.Category_CategoryGroup = $GrpDaily);
  commit $CatTransport;

  $CatSubs = create Ledger.Category (Name = 'Subscriptions', BaselineBudget = 62, SortOrder = 9);
  change $CatSubs (Ledger.Category_CategoryGroup = $GrpLifestyle);
  commit $CatSubs;
  $CatShopping = create Ledger.Category (Name = 'Shopping', BaselineBudget = 260, SortOrder = 10);
  change $CatShopping (Ledger.Category_CategoryGroup = $GrpLifestyle);
  commit $CatShopping;
  $CatHealth = create Ledger.Category (Name = 'Health & sport', BaselineBudget = 145, SortOrder = 11);
  change $CatHealth (Ledger.Category_CategoryGroup = $GrpLifestyle);
  commit $CatHealth;

  $CatInsurance = create Ledger.Category (Name = 'Insurance', BaselineBudget = 305, SortOrder = 12);
  change $CatInsurance (Ledger.Category_CategoryGroup = $GrpFinancial);
  commit $CatInsurance;
  $CatSavings = create Ledger.Category (Name = 'Savings transfer', BaselineBudget = 700, SortOrder = 13);
  change $CatSavings (Ledger.Category_CategoryGroup = $GrpFinancial);
  commit $CatSavings;

  -- MARK: Known merchants

  $M1 = create Ledger.Merchant (Name = 'Koelewijn Holding BV', SortOrder = 1);
  change $M1 (Ledger.Merchant_Category = $CatSalary);
  commit $M1;

  $M2 = create Ledger.Merchant (Name = 'Studio Vermeer', SortOrder = 1);
  change $M2 (Ledger.Merchant_Category = $CatFreelance);
  commit $M2;
  $M3 = create Ledger.Merchant (Name = 'Nieuwe Kade Media', SortOrder = 2);
  change $M3 (Ledger.Merchant_Category = $CatFreelance);
  commit $M3;

  $M4 = create Ledger.Merchant (Name = 'Woonstad Verhuur', SortOrder = 1);
  change $M4 (Ledger.Merchant_Category = $CatRent);
  commit $M4;

  $M5 = create Ledger.Merchant (Name = 'Vattenfall', SortOrder = 1);
  change $M5 (Ledger.Merchant_Category = $CatUtilities);
  commit $M5;
  $M6 = create Ledger.Merchant (Name = 'Waternet', SortOrder = 2);
  change $M6 (Ledger.Merchant_Category = $CatUtilities);
  commit $M6;

  $M7 = create Ledger.Merchant (Name = 'Ziggo', SortOrder = 1);
  change $M7 (Ledger.Merchant_Category = $CatInternet);
  commit $M7;
  $M8 = create Ledger.Merchant (Name = 'Simyo', SortOrder = 2);
  change $M8 (Ledger.Merchant_Category = $CatInternet);
  commit $M8;

  $M9 = create Ledger.Merchant (Name = 'Albert Heijn', SortOrder = 1);
  change $M9 (Ledger.Merchant_Category = $CatGroceries);
  commit $M9;
  $M10 = create Ledger.Merchant (Name = 'Jumbo', SortOrder = 2);
  change $M10 (Ledger.Merchant_Category = $CatGroceries);
  commit $M10;
  $M11 = create Ledger.Merchant (Name = 'Lidl', SortOrder = 3);
  change $M11 (Ledger.Merchant_Category = $CatGroceries);
  commit $M11;
  $M12 = create Ledger.Merchant (Name = 'Marqt', SortOrder = 4);
  change $M12 (Ledger.Merchant_Category = $CatGroceries);
  commit $M12;

  $M13 = create Ledger.Merchant (Name = 'Bar Bruut', SortOrder = 1);
  change $M13 (Ledger.Merchant_Category = $CatRestaurants);
  commit $M13;
  $M14 = create Ledger.Merchant (Name = 'Toko Ramen', SortOrder = 2);
  change $M14 (Ledger.Merchant_Category = $CatRestaurants);
  commit $M14;
  $M15 = create Ledger.Merchant (Name = 'Koffie Kaap', SortOrder = 3);
  change $M15 (Ledger.Merchant_Category = $CatRestaurants);
  commit $M15;
  $M16 = create Ledger.Merchant (Name = 'Thuisbezorgd', SortOrder = 4);
  change $M16 (Ledger.Merchant_Category = $CatRestaurants);
  commit $M16;

  $M17 = create Ledger.Merchant (Name = 'NS Reizen', SortOrder = 1);
  change $M17 (Ledger.Merchant_Category = $CatTransport);
  commit $M17;
  $M18 = create Ledger.Merchant (Name = 'Shell', SortOrder = 2);
  change $M18 (Ledger.Merchant_Category = $CatTransport);
  commit $M18;
  $M19 = create Ledger.Merchant (Name = 'GVB', SortOrder = 3);
  change $M19 (Ledger.Merchant_Category = $CatTransport);
  commit $M19;
  $M20 = create Ledger.Merchant (Name = 'Swapfiets', SortOrder = 4);
  change $M20 (Ledger.Merchant_Category = $CatTransport);
  commit $M20;

  $M21 = create Ledger.Merchant (Name = 'Spotify', SortOrder = 1);
  change $M21 (Ledger.Merchant_Category = $CatSubs);
  commit $M21;
  $M22 = create Ledger.Merchant (Name = 'Netflix', SortOrder = 2);
  change $M22 (Ledger.Merchant_Category = $CatSubs);
  commit $M22;
  $M23 = create Ledger.Merchant (Name = 'iCloud', SortOrder = 3);
  change $M23 (Ledger.Merchant_Category = $CatSubs);
  commit $M23;
  $M24 = create Ledger.Merchant (Name = 'NRC', SortOrder = 4);
  change $M24 (Ledger.Merchant_Category = $CatSubs);
  commit $M24;

  $M25 = create Ledger.Merchant (Name = 'Bol.com', SortOrder = 1);
  change $M25 (Ledger.Merchant_Category = $CatShopping);
  commit $M25;
  $M26 = create Ledger.Merchant (Name = 'Coolblue', SortOrder = 2);
  change $M26 (Ledger.Merchant_Category = $CatShopping);
  commit $M26;
  $M27 = create Ledger.Merchant (Name = 'HEMA', SortOrder = 3);
  change $M27 (Ledger.Merchant_Category = $CatShopping);
  commit $M27;
  $M28 = create Ledger.Merchant (Name = 'Zara', SortOrder = 4);
  change $M28 (Ledger.Merchant_Category = $CatShopping);
  commit $M28;

  $M29 = create Ledger.Merchant (Name = 'Etos', SortOrder = 1);
  change $M29 (Ledger.Merchant_Category = $CatHealth);
  commit $M29;
  $M30 = create Ledger.Merchant (Name = 'TrainMore', SortOrder = 2);
  change $M30 (Ledger.Merchant_Category = $CatHealth);
  commit $M30;
  $M31 = create Ledger.Merchant (Name = 'Tandarts Kade', SortOrder = 3);
  change $M31 (Ledger.Merchant_Category = $CatHealth);
  commit $M31;

  $M32 = create Ledger.Merchant (Name = 'Zilveren Kruis', SortOrder = 1);
  change $M32 (Ledger.Merchant_Category = $CatInsurance);
  commit $M32;
  $M33 = create Ledger.Merchant (Name = 'Centraal Beheer', SortOrder = 2);
  change $M33 (Ledger.Merchant_Category = $CatInsurance);
  commit $M33;
  $M34 = create Ledger.Merchant (Name = 'Aegon', SortOrder = 3);
  change $M34 (Ledger.Merchant_Category = $CatInsurance);
  commit $M34;

  $M35 = create Ledger.Merchant (Name = 'Naar Spaarrekening', SortOrder = 1);
  change $M35 (Ledger.Merchant_Category = $CatSavings);
  commit $M35;

  -- MARK: Budget overrides
  -- Months where the household knowingly deviated from the baseline.

  $B1 = create Ledger.BudgetOverride (MonthKey = '2026-07', Amount = 700);
  change $B1 (Ledger.BudgetOverride_Category = $CatGroceries);
  commit $B1;
  $B2 = create Ledger.BudgetOverride (MonthKey = '2026-05', Amount = 480);
  change $B2 (Ledger.BudgetOverride_Category = $CatShopping);
  commit $B2;
  $B3 = create Ledger.BudgetOverride (MonthKey = '2026-06', Amount = 340);
  change $B3 (Ledger.BudgetOverride_Category = $CatTransport);
  commit $B3;
  $B4 = create Ledger.BudgetOverride (MonthKey = '2026-07', Amount = 1400);
  change $B4 (Ledger.BudgetOverride_Category = $CatFreelance);
  commit $B4;
  $B5 = create Ledger.BudgetOverride (MonthKey = '2026-06', Amount = 320);
  change $B5 (Ledger.BudgetOverride_Category = $CatRestaurants);
  commit $B5;

  -- Earlier years carry deviations too. Without them the Budgets year selector
  -- would step back into a grid of thirteen identical baselines and look like
  -- it had failed to load rather than like a year nobody overrode.
  --
  -- These are the same shape as the reference year's: a summer holiday showing
  -- up as transport and restaurants, a winter energy bill, a December of
  -- presents.
  $B6 = create Ledger.BudgetOverride (MonthKey = '2025-08', Amount = 520);
  change $B6 (Ledger.BudgetOverride_Category = $CatTransport);
  commit $B6;
  $B7 = create Ledger.BudgetOverride (MonthKey = '2025-12', Amount = 640);
  change $B7 (Ledger.BudgetOverride_Category = $CatShopping);
  commit $B7;
  $B8 = create Ledger.BudgetOverride (MonthKey = '2025-01', Amount = 290);
  change $B8 (Ledger.BudgetOverride_Category = $CatUtilities);
  commit $B8;
  $B9 = create Ledger.BudgetOverride (MonthKey = '2024-12', Amount = 580);
  change $B9 (Ledger.BudgetOverride_Category = $CatShopping);
  commit $B9;
  $B10 = create Ledger.BudgetOverride (MonthKey = '2024-02', Amount = 265);
  change $B10 (Ledger.BudgetOverride_Category = $CatUtilities);
  commit $B10;
  $B11 = create Ledger.BudgetOverride (MonthKey = '2023-07', Amount = 410);
  change $B11 (Ledger.BudgetOverride_Category = $CatRestaurants);
  commit $B11;

  -- MARK: Categorisation rules
  -- Evaluated in SortOrder on import; first match wins.

  $R1 = create Ledger.CategoryRule (SortOrder = 1,
    RuleField = Ledger.RuleField.Merchant,
    RuleOperator = Ledger.RuleOperator.Contains, MatchValue = 'Albert Heijn');
  change $R1 (Ledger.CategoryRule_Category = $CatGroceries);
  commit $R1;

  $R2 = create Ledger.CategoryRule (SortOrder = 2,
    RuleField = Ledger.RuleField.Merchant,
    RuleOperator = Ledger.RuleOperator.Contains, MatchValue = 'Jumbo');
  change $R2 (Ledger.CategoryRule_Category = $CatGroceries);
  commit $R2;

  $R3 = create Ledger.CategoryRule (SortOrder = 3,
    RuleField = Ledger.RuleField.Merchant,
    RuleOperator = Ledger.RuleOperator.StartsWith, MatchValue = 'NS ');
  change $R3 (Ledger.CategoryRule_Category = $CatTransport);
  commit $R3;

  $R4 = create Ledger.CategoryRule (SortOrder = 4,
    RuleField = Ledger.RuleField.Merchant,
    RuleOperator = Ledger.RuleOperator.Contains, MatchValue = 'Woonstad');
  change $R4 (Ledger.CategoryRule_Category = $CatRent);
  commit $R4;

  $R5 = create Ledger.CategoryRule (SortOrder = 5,
    RuleField = Ledger.RuleField.Description,
    RuleOperator = Ledger.RuleOperator.Contains, MatchValue = 'SEPA salaris');
  change $R5 (Ledger.CategoryRule_Category = $CatSalary);
  commit $R5;

  $R6 = create Ledger.CategoryRule (SortOrder = 6,
    RuleField = Ledger.RuleField.Merchant,
    RuleOperator = Ledger.RuleOperator.IsOneOf, MatchValue = 'Spotify,Netflix,iCloud');
  change $R6 (Ledger.CategoryRule_Category = $CatSubs);
  commit $R6;

  $R7 = create Ledger.CategoryRule (SortOrder = 7,
    RuleField = Ledger.RuleField.Merchant,
    RuleOperator = Ledger.RuleOperator.Contains, MatchValue = 'Zilveren Kruis');
  change $R7 (Ledger.CategoryRule_Category = $CatInsurance);
  commit $R7;

  @annotation 'Replaces the prototype rule 8, which was not evaluable data'
  $R8 = create Ledger.CategoryRule (SortOrder = 8,
    RuleField = Ledger.RuleField.Merchant,
    RuleOperator = Ledger.RuleOperator.Contains, MatchValue = 'Spaarrekening');
  change $R8 (Ledger.CategoryRule_Category = $CatSavings);
  commit $R8;

  log info node 'LedgerSeed' 'Reference data created';
  set $Done = true;
  return $Done;
end;
/
