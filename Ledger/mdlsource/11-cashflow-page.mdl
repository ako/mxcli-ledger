-- ============================================================================
-- 09 - Cashflow page
-- ============================================================================
-- The matrix is a DataGrid2 with 14 static columns. Static columns are what
-- makes this work: they align by construction across rows, which a nested
-- gallery of cells would not (each row would size its own columns).
--
-- Every month column carries DynamicCellClass bound to that month's Band
-- attribute, which is how the prototype's continuous heatmap becomes ten
-- discrete classes. The classes themselves live in
-- theme/web/custom/ledger-cashflow.scss.
--
-- The month cells are custom content rather than plain attribute columns so the
-- value can sit inside a clickable container. The band stays on the column's
-- DynamicCellClass — the tint belongs to the whole cell, not to the container
-- inside it — and the container only carries the click and the cursor.
--
-- The sparklines are a column of this grid, and they are declared here rather
-- than added by a later file. They used to be a separate card below the matrix,
-- inserted by 23-cashflow-sparklines.mdl with ALTER PAGE ... INSERT, and this
-- file is CREATE OR REPLACE PAGE — so the next edit to the matrix silently
-- deleted them, which is exactly how they went missing. It is the same trap
-- navigation fell into twice: page-spanning state needs one owner. The page has
-- one now, and it is this file.
-- ============================================================================

/**
 * Cashflow report: categories by month, with group subtotals and a net line.
 *
 * The DataGrid2 sits inside a DataView over a non-persistent ReportContext, so
 * the mode buttons mutate one object and the grid's microflow datasource picks
 * the change up on refresh.
 */
create or replace page Ledger.Cashflow_Overview
(
  title: 'Cashflow',
  layout: Atlas_Core.Atlas_Default,
  url: 'cashflow',
  folder: 'Ledger'
)
{
  layoutgrid lgCashflow {
    row rowMain {
      column colBody (desktopwidth: 12) {
        dataview dvContext (datasource: microflow Ledger.DS_ReportContext) {
          dynamictext txtHeading (content: 'Cashflow', rendermode: H2)
          dynamictext txtSub (attribute: Subheading, rendermode: paragraph, class: 'text-muted')

          -- Mode switch
          container ctnModes (class: 'ledger-modes') {
            actionbutton btnActual (
              caption: 'Actual',
              action: microflow Ledger.ACT_ModeActual(Context: $currentObject))
            actionbutton btnBudget (
              caption: 'Budget',
              action: microflow Ledger.ACT_ModeBudget(Context: $currentObject))
            actionbutton btnVariance (
              caption: 'Variance',
              action: microflow Ledger.ACT_ModeVariance(Context: $currentObject))
          }

          -- Headline figures, elapsed months only
          layoutgrid lgKpis {
            row rowKpis {
              column colKpiIncome (desktopwidth: 3) {
                container ctnKpiIncome (class: 'card ledger-kpi') {
                  dynamictext lblIncome (content: 'Income', rendermode: H6)
                  dynamictext valIncome (attribute: KpiIncome, rendermode: H3)
                }
              }
              column colKpiSpend (desktopwidth: 3) {
                container ctnKpiSpend (class: 'card ledger-kpi') {
                  dynamictext lblSpend (content: 'Spend', rendermode: H6)
                  dynamictext valSpend (attribute: KpiSpend, rendermode: H3)
                }
              }
              column colKpiNet (desktopwidth: 3) {
                container ctnKpiNet (class: 'card ledger-kpi') {
                  dynamictext lblNet (content: 'Net', rendermode: H6)
                  dynamictext valNet (attribute: KpiNet, rendermode: H3)
                }
              }
              column colKpiOver (desktopwidth: 3) {
                container ctnKpiOver (class: 'card ledger-kpi') {
                  dynamictext lblOver (content: 'Over budget', rendermode: H6)
                  dynamictext valOver (attribute: KpiOver, rendermode: H3)
                }
              }
            }
          }

          -- The matrix and the inspector, side by side. The panel is where the
          -- prototype put the drilldown, and being on the page rather than in a
          -- popup is what lets the matrix stay readable while the detail is
          -- read. It costs the matrix a quarter of its width, so more of the
          -- year sits off-scroll — the legend below says the matrix scrolls.
          layoutgrid lgMatrixRow {
            row rowMatrix {
              column colMatrix (desktopwidth: 9) {
          datagrid dgMatrix (
            datasource: microflow Ledger.DS_CashflowRows,
            PageSize: 40,
            class: 'ledger-matrix'
          ) {
            column colLabel (
              attribute: Label, caption: 'Category',
              Sortable: false, Draggable: false,
              ColumnWidth: manual, Size: 190,
              DynamicCellClass: 'if $currentObject/RowKind = Ledger.RowKind.Group then ''cf-group'' else if $currentObject/RowKind = Ledger.RowKind.Net then ''cf-net'' else ''cf-cat''')
            -- The trend column: one sparkline per row, rendered by the Vega
            -- widget from the row's own SparkData.
            --
            -- It sits second, not last, because the matrix scrolls sideways —
            -- a trend column past December would be off-screen exactly when the
            -- shape is most useful. Next to the label it is the first thing read
            -- after the category name.
            --
            -- Fourteen widget instances share one spec string, which is the same
            -- split the standalone chart used: the microflow emits a table of
            -- rows and the model never generates layout. What changed is the
            -- grain. A facet grid needed one payload carrying every category and
            -- a `facet` operator to cut it back up; a column already has one
            -- chart per row, so each row carries only its own twelve months and
            -- the spec has no facet at all.
            --
            -- Group and net rows get one too. Their figures are roll-ups of the
            -- categories below them, so the line is a real quantity — and it is
            -- the roll-up rows whose shape is hardest to read off twelve cells.
            column colSpark (
              caption: 'Trend',
              Sortable: false, Draggable: false,
              ColumnWidth: manual, Size: 150,
              -- Not the label column's row-kind classes. Those are typographic
              -- (mono, uppercase, and a 24px indent for categories) and a chart
              -- has no type to set — the indent would only cost it width.
              DynamicCellClass: '''cf-spark'''
            ) {
              pluggablewidget 'ledger.widget.web.vegachart.VegaChart' chartSpark (
                chartData: SparkData,
                datasetName: 'table',
                chartHeight: 30,
                renderer: 'svg',
                showActions: false,
                spec: '{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "data": {"name": "table"},
  "background": null,
  "width": 126,
  "height": 26,
  "padding": 2,
  "autosize": {"type": "fit", "contains": "padding"},
  "config": {"view": {"stroke": null}},
  "transform": [
    {"calculate": "[''Jan'',''Feb'',''Mar'',''Apr'',''May'',''Jun'',''Jul'',''Aug'',''Sep'',''Oct'',''Nov'',''Dec''][datum.m - 1]", "as": "mon"}
  ],
  "layer": [
    {
      "description": "The miss, as the area between actual and budget. It is the quantity the row is actually about, and shading it means the eye reads how far off rather than only which side. Filtered to elapsed months rather than left to break on the null: an area whose y is null still closes one step past the last point, which drew a small block into September that looked like data.",
      "transform": [{"filter": "isValid(datum.a)"}],
      "mark": {"type": "area", "color": "#1B4D4B", "opacity": 0.08},
      "encoding": {"y": {"field": "a", "type": "quantitative"}, "y2": {"field": "b"}}
    },
    {
      "description": "Budget, as a step reference line. It was an area from zero at first, which forced the y scale to include zero and flattened every line into the top of a 26px cell — a category that varies between 544 and 698 has no visible shape once the axis starts at 0.",
      "mark": {"type": "line", "color": "#B9B1A1", "strokeWidth": 1, "interpolate": "step-after"},
      "encoding": {"y": {"field": "b", "type": "quantitative"}}
    },
    {
      "description": "Actual. Nulls after the last elapsed month break the line rather than drawing it to zero.",
      "mark": {"type": "line", "color": "#1B4D4B", "strokeWidth": 1.2},
      "encoding": {"y": {"field": "a", "type": "quantitative"}}
    },
    {
      "description": "Unfavourable months. The only place a row spends a strong colour, and it marks the months worth clicking. The flag is computed in the builder against the same rule that tints the cell — the spec cannot know that above budget is good news on a salary row.",
      "transform": [{"filter": "isValid(datum.a) && datum.u === 1"}],
      "mark": {"type": "point", "color": "#A8321E", "size": 12, "filled": true},
      "encoding": {"y": {"field": "a", "type": "quantitative"}}
    }
  ],
  "encoding": {
    "x": {
      "field": "m", "type": "quantitative",
      "scale": {"domain": [1, 12], "nice": false},
      "axis": null
    },
    "y": {"axis": null, "scale": {"zero": false, "nice": false}},
    "tooltip": [
      {"field": "mon", "type": "nominal", "title": "Month"},
      {"field": "a", "type": "quantitative", "title": "Actual", "format": ",.2f"},
      {"field": "b", "type": "quantitative", "title": "Budget", "format": ",.2f"}
    ]
  }
}')
            }
            column colM01 (
              caption: 'Jan', Alignment: right,
              Sortable: false, ColumnWidth: manual, Size: 132,
              DynamicCellClass: '''cf-cell '' + $currentObject/M01Band + (if $currentObject/Ledger.CashflowRow_Context/Ledger.ReportContext/DrillSortKey = $currentObject/SortOrder and $currentObject/Ledger.CashflowRow_Context/Ledger.ReportContext/DrillMonthIndex = 1 then '' cf-sel'' else '''')'
            ) {
              container cellM01 (
                onclick: microflow Ledger.ACT_DrillCell(Row: $currentObject, MonthIndex: 1),
                dynamicclasses: 'if $currentObject/RowKind = Ledger.RowKind.Category then ''cf-drill'' else ''cf-nodrill'''
              ) {
                dynamictext txtM01 (attribute: M01Text)
              }
            }
            column colM02 (
              caption: 'Feb', Alignment: right,
              Sortable: false, ColumnWidth: manual, Size: 132,
              DynamicCellClass: '''cf-cell '' + $currentObject/M02Band + (if $currentObject/Ledger.CashflowRow_Context/Ledger.ReportContext/DrillSortKey = $currentObject/SortOrder and $currentObject/Ledger.CashflowRow_Context/Ledger.ReportContext/DrillMonthIndex = 2 then '' cf-sel'' else '''')'
            ) {
              container cellM02 (
                onclick: microflow Ledger.ACT_DrillCell(Row: $currentObject, MonthIndex: 2),
                dynamicclasses: 'if $currentObject/RowKind = Ledger.RowKind.Category then ''cf-drill'' else ''cf-nodrill'''
              ) {
                dynamictext txtM02 (attribute: M02Text)
              }
            }
            column colM03 (
              caption: 'Mar', Alignment: right,
              Sortable: false, ColumnWidth: manual, Size: 132,
              DynamicCellClass: '''cf-cell '' + $currentObject/M03Band + (if $currentObject/Ledger.CashflowRow_Context/Ledger.ReportContext/DrillSortKey = $currentObject/SortOrder and $currentObject/Ledger.CashflowRow_Context/Ledger.ReportContext/DrillMonthIndex = 3 then '' cf-sel'' else '''')'
            ) {
              container cellM03 (
                onclick: microflow Ledger.ACT_DrillCell(Row: $currentObject, MonthIndex: 3),
                dynamicclasses: 'if $currentObject/RowKind = Ledger.RowKind.Category then ''cf-drill'' else ''cf-nodrill'''
              ) {
                dynamictext txtM03 (attribute: M03Text)
              }
            }
            column colM04 (
              caption: 'Apr', Alignment: right,
              Sortable: false, ColumnWidth: manual, Size: 132,
              DynamicCellClass: '''cf-cell '' + $currentObject/M04Band + (if $currentObject/Ledger.CashflowRow_Context/Ledger.ReportContext/DrillSortKey = $currentObject/SortOrder and $currentObject/Ledger.CashflowRow_Context/Ledger.ReportContext/DrillMonthIndex = 4 then '' cf-sel'' else '''')'
            ) {
              container cellM04 (
                onclick: microflow Ledger.ACT_DrillCell(Row: $currentObject, MonthIndex: 4),
                dynamicclasses: 'if $currentObject/RowKind = Ledger.RowKind.Category then ''cf-drill'' else ''cf-nodrill'''
              ) {
                dynamictext txtM04 (attribute: M04Text)
              }
            }
            column colM05 (
              caption: 'May', Alignment: right,
              Sortable: false, ColumnWidth: manual, Size: 132,
              DynamicCellClass: '''cf-cell '' + $currentObject/M05Band + (if $currentObject/Ledger.CashflowRow_Context/Ledger.ReportContext/DrillSortKey = $currentObject/SortOrder and $currentObject/Ledger.CashflowRow_Context/Ledger.ReportContext/DrillMonthIndex = 5 then '' cf-sel'' else '''')'
            ) {
              container cellM05 (
                onclick: microflow Ledger.ACT_DrillCell(Row: $currentObject, MonthIndex: 5),
                dynamicclasses: 'if $currentObject/RowKind = Ledger.RowKind.Category then ''cf-drill'' else ''cf-nodrill'''
              ) {
                dynamictext txtM05 (attribute: M05Text)
              }
            }
            column colM06 (
              caption: 'Jun', Alignment: right,
              Sortable: false, ColumnWidth: manual, Size: 132,
              DynamicCellClass: '''cf-cell '' + $currentObject/M06Band + (if $currentObject/Ledger.CashflowRow_Context/Ledger.ReportContext/DrillSortKey = $currentObject/SortOrder and $currentObject/Ledger.CashflowRow_Context/Ledger.ReportContext/DrillMonthIndex = 6 then '' cf-sel'' else '''')'
            ) {
              container cellM06 (
                onclick: microflow Ledger.ACT_DrillCell(Row: $currentObject, MonthIndex: 6),
                dynamicclasses: 'if $currentObject/RowKind = Ledger.RowKind.Category then ''cf-drill'' else ''cf-nodrill'''
              ) {
                dynamictext txtM06 (attribute: M06Text)
              }
            }
            column colM07 (
              caption: 'Jul', Alignment: right,
              Sortable: false, ColumnWidth: manual, Size: 132,
              DynamicCellClass: '''cf-cell '' + $currentObject/M07Band + (if $currentObject/Ledger.CashflowRow_Context/Ledger.ReportContext/DrillSortKey = $currentObject/SortOrder and $currentObject/Ledger.CashflowRow_Context/Ledger.ReportContext/DrillMonthIndex = 7 then '' cf-sel'' else '''')'
            ) {
              container cellM07 (
                onclick: microflow Ledger.ACT_DrillCell(Row: $currentObject, MonthIndex: 7),
                dynamicclasses: 'if $currentObject/RowKind = Ledger.RowKind.Category then ''cf-drill'' else ''cf-nodrill'''
              ) {
                dynamictext txtM07 (attribute: M07Text)
              }
            }
            column colM08 (
              caption: 'Aug', Alignment: right,
              Sortable: false, ColumnWidth: manual, Size: 132,
              DynamicCellClass: '''cf-cell '' + $currentObject/M08Band + (if $currentObject/Ledger.CashflowRow_Context/Ledger.ReportContext/DrillSortKey = $currentObject/SortOrder and $currentObject/Ledger.CashflowRow_Context/Ledger.ReportContext/DrillMonthIndex = 8 then '' cf-sel'' else '''')'
            ) {
              container cellM08 (
                onclick: microflow Ledger.ACT_DrillCell(Row: $currentObject, MonthIndex: 8),
                dynamicclasses: 'if $currentObject/RowKind = Ledger.RowKind.Category then ''cf-drill'' else ''cf-nodrill'''
              ) {
                dynamictext txtM08 (attribute: M08Text)
              }
            }
            column colM09 (
              caption: 'Sep', Alignment: right,
              Sortable: false, ColumnWidth: manual, Size: 132,
              DynamicCellClass: '''cf-cell '' + $currentObject/M09Band + (if $currentObject/Ledger.CashflowRow_Context/Ledger.ReportContext/DrillSortKey = $currentObject/SortOrder and $currentObject/Ledger.CashflowRow_Context/Ledger.ReportContext/DrillMonthIndex = 9 then '' cf-sel'' else '''')'
            ) {
              container cellM09 (
                onclick: microflow Ledger.ACT_DrillCell(Row: $currentObject, MonthIndex: 9),
                dynamicclasses: 'if $currentObject/RowKind = Ledger.RowKind.Category then ''cf-drill'' else ''cf-nodrill'''
              ) {
                dynamictext txtM09 (attribute: M09Text)
              }
            }
            column colM10 (
              caption: 'Oct', Alignment: right,
              Sortable: false, ColumnWidth: manual, Size: 132,
              DynamicCellClass: '''cf-cell '' + $currentObject/M10Band + (if $currentObject/Ledger.CashflowRow_Context/Ledger.ReportContext/DrillSortKey = $currentObject/SortOrder and $currentObject/Ledger.CashflowRow_Context/Ledger.ReportContext/DrillMonthIndex = 10 then '' cf-sel'' else '''')'
            ) {
              container cellM10 (
                onclick: microflow Ledger.ACT_DrillCell(Row: $currentObject, MonthIndex: 10),
                dynamicclasses: 'if $currentObject/RowKind = Ledger.RowKind.Category then ''cf-drill'' else ''cf-nodrill'''
              ) {
                dynamictext txtM10 (attribute: M10Text)
              }
            }
            column colM11 (
              caption: 'Nov', Alignment: right,
              Sortable: false, ColumnWidth: manual, Size: 132,
              DynamicCellClass: '''cf-cell '' + $currentObject/M11Band + (if $currentObject/Ledger.CashflowRow_Context/Ledger.ReportContext/DrillSortKey = $currentObject/SortOrder and $currentObject/Ledger.CashflowRow_Context/Ledger.ReportContext/DrillMonthIndex = 11 then '' cf-sel'' else '''')'
            ) {
              container cellM11 (
                onclick: microflow Ledger.ACT_DrillCell(Row: $currentObject, MonthIndex: 11),
                dynamicclasses: 'if $currentObject/RowKind = Ledger.RowKind.Category then ''cf-drill'' else ''cf-nodrill'''
              ) {
                dynamictext txtM11 (attribute: M11Text)
              }
            }
            column colM12 (
              caption: 'Dec', Alignment: right,
              Sortable: false, ColumnWidth: manual, Size: 132,
              DynamicCellClass: '''cf-cell '' + $currentObject/M12Band + (if $currentObject/Ledger.CashflowRow_Context/Ledger.ReportContext/DrillSortKey = $currentObject/SortOrder and $currentObject/Ledger.CashflowRow_Context/Ledger.ReportContext/DrillMonthIndex = 12 then '' cf-sel'' else '''')'
            ) {
              container cellM12 (
                onclick: microflow Ledger.ACT_DrillCell(Row: $currentObject, MonthIndex: 12),
                dynamicclasses: 'if $currentObject/RowKind = Ledger.RowKind.Category then ''cf-drill'' else ''cf-nodrill'''
              ) {
                dynamictext txtM12 (attribute: M12Text)
              }
            }
            column colTotal (
              attribute: TotalText, caption: 'Total', Alignment: right,
              Sortable: false, ColumnWidth: manual, Size: 150,
              DynamicCellClass: '''cf-total''')
          }

                container ctnLegend (class: 'ledger-legend') {
                  container ctnLegendOver (class: 'ledger-legend-item') {
                    container swOver (class: 'ledger-swatch ledger-swatch-over') {
                      dynamictext txtSwOver (content: ' ')
                    }
                    dynamictext txtLegendOver (content: 'Over budget')
                  }
                  container ctnLegendUnder (class: 'ledger-legend-item') {
                    container swUnder (class: 'ledger-swatch ledger-swatch-under') {
                      dynamictext txtSwUnder (content: ' ')
                    }
                    dynamictext txtLegendUnder (content: 'Under budget')
                  }
                  dynamictext txtLegendHint (
                    content: 'The matrix scrolls sideways. Click any cell to inspect its transactions.',
                    class: 'ledger-legend-hint')
                }
              }

              -- The inspector.
              column colInspector (desktopwidth: 3) {
                container ctnInspector (class: 'card ledger-inspector') {
                  container ctnInspectorHead (class: 'ledger-inspector-head') {
                    dynamictext txtDrillKicker (attribute: DrillKicker, class: 'ledger-kicker')
                    dynamictext txtDrillTitle (attribute: DrillTitle, rendermode: H5)
                    dynamictext txtDrillMeta (attribute: DrillMeta, class: 'ledger-inspector-meta')
                  }
                  -- A database datasource, not a microflow. Nothing here takes the
                  -- ReportContext as a datasource *parameter*, so ACT_DrillCell can
                  -- move the selection without refreshing it — which is what stopped
                  -- every click rebuilding all 228 matrix cells. The constraint
                  -- re-queries on a plain attribute change (verified).
                  listview lvDrill (
                    datasource: database from Ledger.VTransactionLine
                      where [CategoryId = $currentObject/DrillCategoryId]
                        and [Yr = 2026]
                        and [MonthIndex = $currentObject/DrillMonthIndex]
                      sort by TxDate asc,
                    class: 'ledger-inspector-list'
                  ) {
                    template tplDrill {
                      -- The row opens the transaction. A container's OnClick is
                      -- the only place this can hang: the row is not a button,
                      -- and a listview has no per-row action of its own.
                      container ctnLine (
                        class: 'ledger-line ledger-line-clickable',
                        onclick: microflow Ledger.ACT_ShowTransaction(Line: $currentObject)
                      ) {
                        container ctnLineText (class: 'ledger-line-text') {
                          dynamictext txtLineMerchant (attribute: Merchant, class: 'ledger-line-merchant')
                          dynamictext txtLineMeta (
                            content: '{1} · {2}',
                            contentparams: [{1} = TxDate format (dateFormat: Custom, customDateFormat: 'd MMM'), {2} = AccountName],
                            class: 'ledger-line-meta')
                        }
                        dynamictext txtLineAmount (
                          content: '{1}€ {2}',
                          contentparams: [{1} = Sign, {2} = AbsAmount format (decimalPrecision: 2, groupDigits: true)],
                          class: 'ledger-line-amount')
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
/

-- Navigation is not written here. It used to be written by four files, each
-- carrying the menu as it stood at that point, so running any one of them on
-- its own silently reverted the menu to an older shape — a trap this project
-- fell into twice. It now has a single owner: 27-navigation.mdl.
