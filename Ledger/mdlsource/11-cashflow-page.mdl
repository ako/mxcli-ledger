-- ============================================================================
-- 09 - Cashflow page
-- ============================================================================
-- The matrix is a DataGrid2 with 14 static columns. Static columns are what
-- makes this work: they align by construction across rows, which a nested
-- gallery of cells would not (each row would size its own columns).
--
-- Every month column carries DynamicCellClass bound to that month's Band
-- attribute, which is how the prototype's continuous heatmap becomes ten
-- discrete classes. The classes themselves live in
-- theme/web/custom/ledger-cashflow.scss.
--
-- The month cells are custom content rather than plain attribute columns so the
-- value can sit inside a clickable container. The band stays on the column's
-- DynamicCellClass — the tint belongs to the whole cell, not to the container
-- inside it — and the container only carries the click and the cursor.
-- ============================================================================

/**
 * Cashflow report: categories by month, with group subtotals and a net line.
 *
 * The DataGrid2 sits inside a DataView over a non-persistent ReportContext, so
 * the mode buttons mutate one object and the grid's microflow datasource picks
 * the change up on refresh.
 */
create or replace page Ledger.Cashflow_Overview
(
  title: 'Cashflow',
  layout: Atlas_Core.Atlas_Default,
  url: 'cashflow',
  folder: 'Ledger'
)
{
  layoutgrid lgCashflow {
    row rowMain {
      column colMenu (desktopwidth: 2) {
        snippetcall snMenu (snippet: Ledger.SNIPPET_LedgerMenu)
      }
      column colBody (desktopwidth: 10) {
        dataview dvContext (datasource: microflow Ledger.DS_ReportContext) {
          dynamictext txtHeading (content: 'Cashflow', rendermode: H2)
          dynamictext txtSub (attribute: Subheading, rendermode: paragraph, class: 'text-muted')

          -- Mode switch
          container ctnModes (class: 'ledger-modes') {
            actionbutton btnActual (
              caption: 'Actual',
              action: microflow Ledger.ACT_ModeActual(Context: $currentObject))
            actionbutton btnBudget (
              caption: 'Budget',
              action: microflow Ledger.ACT_ModeBudget(Context: $currentObject))
            actionbutton btnVariance (
              caption: 'Variance',
              action: microflow Ledger.ACT_ModeVariance(Context: $currentObject))
          }

          -- Headline figures, elapsed months only
          layoutgrid lgKpis {
            row rowKpis {
              column colKpiIncome (desktopwidth: 3) {
                container ctnKpiIncome (class: 'card ledger-kpi') {
                  dynamictext lblIncome (content: 'Income', rendermode: H6)
                  dynamictext valIncome (attribute: KpiIncome, rendermode: H3)
                }
              }
              column colKpiSpend (desktopwidth: 3) {
                container ctnKpiSpend (class: 'card ledger-kpi') {
                  dynamictext lblSpend (content: 'Spend', rendermode: H6)
                  dynamictext valSpend (attribute: KpiSpend, rendermode: H3)
                }
              }
              column colKpiNet (desktopwidth: 3) {
                container ctnKpiNet (class: 'card ledger-kpi') {
                  dynamictext lblNet (content: 'Net', rendermode: H6)
                  dynamictext valNet (attribute: KpiNet, rendermode: H3)
                }
              }
              column colKpiOver (desktopwidth: 3) {
                container ctnKpiOver (class: 'card ledger-kpi') {
                  dynamictext lblOver (content: 'Over budget', rendermode: H6)
                  dynamictext valOver (attribute: KpiOver, rendermode: H3)
                }
              }
            }
          }

          -- The matrix and the inspector, side by side. The panel is where the
          -- prototype put the drilldown, and being on the page rather than in a
          -- popup is what lets the matrix stay readable while the detail is
          -- read. It costs the matrix a quarter of its width, so more of the
          -- year sits off-scroll — the legend below says the matrix scrolls.
          layoutgrid lgMatrixRow {
            row rowMatrix {
              column colMatrix (desktopwidth: 9) {
          datagrid dgMatrix (
            datasource: microflow Ledger.DS_CashflowRows,
            PageSize: 40,
            class: 'ledger-matrix'
          ) {
            column colLabel (
              attribute: Label, caption: 'Category',
              Sortable: false, Draggable: false,
              ColumnWidth: manual, Size: 190,
              DynamicCellClass: 'if $currentObject/RowKind = Ledger.RowKind.Group then ''cf-group'' else if $currentObject/RowKind = Ledger.RowKind.Net then ''cf-net'' else ''cf-cat''')
            column colM01 (
              caption: 'Jan', Alignment: right,
              Sortable: false, ColumnWidth: manual, Size: 132,
              DynamicCellClass: '''cf-cell '' + $currentObject/M01Band'
            ) {
              container cellM01 (
                onclick: microflow Ledger.ACT_DrillCell(Row: $currentObject, MonthIndex: 1),
                dynamicclasses: 'if $currentObject/RowKind = Ledger.RowKind.Category then ''cf-drill'' else ''cf-nodrill'''
              ) {
                dynamictext txtM01 (attribute: M01Text)
              }
            }
            column colM02 (
              caption: 'Feb', Alignment: right,
              Sortable: false, ColumnWidth: manual, Size: 132,
              DynamicCellClass: '''cf-cell '' + $currentObject/M02Band'
            ) {
              container cellM02 (
                onclick: microflow Ledger.ACT_DrillCell(Row: $currentObject, MonthIndex: 2),
                dynamicclasses: 'if $currentObject/RowKind = Ledger.RowKind.Category then ''cf-drill'' else ''cf-nodrill'''
              ) {
                dynamictext txtM02 (attribute: M02Text)
              }
            }
            column colM03 (
              caption: 'Mar', Alignment: right,
              Sortable: false, ColumnWidth: manual, Size: 132,
              DynamicCellClass: '''cf-cell '' + $currentObject/M03Band'
            ) {
              container cellM03 (
                onclick: microflow Ledger.ACT_DrillCell(Row: $currentObject, MonthIndex: 3),
                dynamicclasses: 'if $currentObject/RowKind = Ledger.RowKind.Category then ''cf-drill'' else ''cf-nodrill'''
              ) {
                dynamictext txtM03 (attribute: M03Text)
              }
            }
            column colM04 (
              caption: 'Apr', Alignment: right,
              Sortable: false, ColumnWidth: manual, Size: 132,
              DynamicCellClass: '''cf-cell '' + $currentObject/M04Band'
            ) {
              container cellM04 (
                onclick: microflow Ledger.ACT_DrillCell(Row: $currentObject, MonthIndex: 4),
                dynamicclasses: 'if $currentObject/RowKind = Ledger.RowKind.Category then ''cf-drill'' else ''cf-nodrill'''
              ) {
                dynamictext txtM04 (attribute: M04Text)
              }
            }
            column colM05 (
              caption: 'May', Alignment: right,
              Sortable: false, ColumnWidth: manual, Size: 132,
              DynamicCellClass: '''cf-cell '' + $currentObject/M05Band'
            ) {
              container cellM05 (
                onclick: microflow Ledger.ACT_DrillCell(Row: $currentObject, MonthIndex: 5),
                dynamicclasses: 'if $currentObject/RowKind = Ledger.RowKind.Category then ''cf-drill'' else ''cf-nodrill'''
              ) {
                dynamictext txtM05 (attribute: M05Text)
              }
            }
            column colM06 (
              caption: 'Jun', Alignment: right,
              Sortable: false, ColumnWidth: manual, Size: 132,
              DynamicCellClass: '''cf-cell '' + $currentObject/M06Band'
            ) {
              container cellM06 (
                onclick: microflow Ledger.ACT_DrillCell(Row: $currentObject, MonthIndex: 6),
                dynamicclasses: 'if $currentObject/RowKind = Ledger.RowKind.Category then ''cf-drill'' else ''cf-nodrill'''
              ) {
                dynamictext txtM06 (attribute: M06Text)
              }
            }
            column colM07 (
              caption: 'Jul', Alignment: right,
              Sortable: false, ColumnWidth: manual, Size: 132,
              DynamicCellClass: '''cf-cell '' + $currentObject/M07Band'
            ) {
              container cellM07 (
                onclick: microflow Ledger.ACT_DrillCell(Row: $currentObject, MonthIndex: 7),
                dynamicclasses: 'if $currentObject/RowKind = Ledger.RowKind.Category then ''cf-drill'' else ''cf-nodrill'''
              ) {
                dynamictext txtM07 (attribute: M07Text)
              }
            }
            column colM08 (
              caption: 'Aug', Alignment: right,
              Sortable: false, ColumnWidth: manual, Size: 132,
              DynamicCellClass: '''cf-cell '' + $currentObject/M08Band'
            ) {
              container cellM08 (
                onclick: microflow Ledger.ACT_DrillCell(Row: $currentObject, MonthIndex: 8),
                dynamicclasses: 'if $currentObject/RowKind = Ledger.RowKind.Category then ''cf-drill'' else ''cf-nodrill'''
              ) {
                dynamictext txtM08 (attribute: M08Text)
              }
            }
            column colM09 (
              caption: 'Sep', Alignment: right,
              Sortable: false, ColumnWidth: manual, Size: 132,
              DynamicCellClass: '''cf-cell '' + $currentObject/M09Band'
            ) {
              container cellM09 (
                onclick: microflow Ledger.ACT_DrillCell(Row: $currentObject, MonthIndex: 9),
                dynamicclasses: 'if $currentObject/RowKind = Ledger.RowKind.Category then ''cf-drill'' else ''cf-nodrill'''
              ) {
                dynamictext txtM09 (attribute: M09Text)
              }
            }
            column colM10 (
              caption: 'Oct', Alignment: right,
              Sortable: false, ColumnWidth: manual, Size: 132,
              DynamicCellClass: '''cf-cell '' + $currentObject/M10Band'
            ) {
              container cellM10 (
                onclick: microflow Ledger.ACT_DrillCell(Row: $currentObject, MonthIndex: 10),
                dynamicclasses: 'if $currentObject/RowKind = Ledger.RowKind.Category then ''cf-drill'' else ''cf-nodrill'''
              ) {
                dynamictext txtM10 (attribute: M10Text)
              }
            }
            column colM11 (
              caption: 'Nov', Alignment: right,
              Sortable: false, ColumnWidth: manual, Size: 132,
              DynamicCellClass: '''cf-cell '' + $currentObject/M11Band'
            ) {
              container cellM11 (
                onclick: microflow Ledger.ACT_DrillCell(Row: $currentObject, MonthIndex: 11),
                dynamicclasses: 'if $currentObject/RowKind = Ledger.RowKind.Category then ''cf-drill'' else ''cf-nodrill'''
              ) {
                dynamictext txtM11 (attribute: M11Text)
              }
            }
            column colM12 (
              caption: 'Dec', Alignment: right,
              Sortable: false, ColumnWidth: manual, Size: 132,
              DynamicCellClass: '''cf-cell '' + $currentObject/M12Band'
            ) {
              container cellM12 (
                onclick: microflow Ledger.ACT_DrillCell(Row: $currentObject, MonthIndex: 12),
                dynamicclasses: 'if $currentObject/RowKind = Ledger.RowKind.Category then ''cf-drill'' else ''cf-nodrill'''
              ) {
                dynamictext txtM12 (attribute: M12Text)
              }
            }
            column colTotal (
              attribute: TotalText, caption: 'Total', Alignment: right,
              Sortable: false, ColumnWidth: manual, Size: 150,
              DynamicCellClass: '''cf-total''')
          }

                container ctnLegend (class: 'ledger-legend') {
                  container ctnLegendOver (class: 'ledger-legend-item') {
                    container swOver (class: 'ledger-swatch ledger-swatch-over') {
                      dynamictext txtSwOver (content: ' ')
                    }
                    dynamictext txtLegendOver (content: 'Over budget')
                  }
                  container ctnLegendUnder (class: 'ledger-legend-item') {
                    container swUnder (class: 'ledger-swatch ledger-swatch-under') {
                      dynamictext txtSwUnder (content: ' ')
                    }
                    dynamictext txtLegendUnder (content: 'Under budget')
                  }
                  dynamictext txtLegendHint (
                    content: 'The matrix scrolls sideways. Click any cell to inspect its transactions.',
                    class: 'ledger-legend-hint')
                }
              }

              -- The inspector.
              column colInspector (desktopwidth: 3) {
                container ctnInspector (class: 'card ledger-inspector') {
                  container ctnInspectorHead (class: 'ledger-inspector-head') {
                    dynamictext txtDrillKicker (attribute: DrillKicker, class: 'ledger-kicker')
                    dynamictext txtDrillTitle (attribute: DrillTitle, rendermode: H5)
                    dynamictext txtDrillMeta (attribute: DrillMeta, class: 'ledger-inspector-meta')
                  }
                  listview lvDrill (
                    datasource: microflow Ledger.DS_DrillLines,
                    class: 'ledger-inspector-list'
                  ) {
                    template tplDrill {
                      container ctnLine (class: 'ledger-line') {
                        container ctnLineText (class: 'ledger-line-text') {
                          dynamictext txtLineMerchant (attribute: Merchant, class: 'ledger-line-merchant')
                          dynamictext txtLineMeta (attribute: MetaText, class: 'ledger-line-meta')
                        }
                        dynamictext txtLineAmount (attribute: AmountText, class: 'ledger-line-amount')
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
/

/**
 * Menu, now including Cashflow.
 */
create or replace snippet Ledger.SNIPPET_LedgerMenu
folder 'Navigation'
{
  container ctnMenu (class: 'card') {
    dynamictext txtMenuTitle (content: 'Ledger', rendermode: H4)
    actionbutton btnCashflow (
      caption: 'Cashflow',
      action: show_page Ledger.Cashflow_Overview,
      class: 'btn-block')
    actionbutton btnTransactions (
      caption: 'Transactions',
      action: show_page Ledger.Transaction_Overview,
      class: 'btn-block')
    actionbutton btnAccounts (
      caption: 'Accounts',
      action: show_page Ledger.Account_Overview,
      class: 'btn-block')
    actionbutton btnCategories (
      caption: 'Categories & rules',
      action: show_page Ledger.Category_Overview,
      class: 'btn-block')
  }
}
/

create or replace navigation Responsive
  home page Ledger.Cashflow_Overview
  menu (
    menu item 'Cashflow' page Ledger.Cashflow_Overview;
    menu item 'Transactions' page Ledger.Transaction_Overview;
    menu item 'Accounts' page Ledger.Account_Overview;
    menu item 'Categories & rules' page Ledger.Category_Overview;
  );
/
