-- ============================================================================
-- 08 - Cashflow datasources
-- ============================================================================
-- DS_ReportContext builds the screen state and headline figures.
-- DS_CashflowRows builds the matrix rows for the current mode.
--
-- Both walk categories x months and call the CALC_* helpers, so the elapsed
-- rule is applied in exactly one place per concern.
-- ============================================================================

/**
 * Current month within 2026, clamped to the calendar year.
 *
 * Derived from the clock rather than hardcoded so the report stays correct as
 * 2026 progresses — August's actuals appear in August without a code change.
 *
 * @returns 0 before 2026, 1-12 during 2026, 12 after
 */
create or modify microflow Ledger.CALC_ElapsedThrough ()
returns integer as $Through
folder 'Cashflow'
begin
  declare $Through integer = 12;
  declare $Year integer = 0;

  set $Year = parseInteger(formatDateTime([%CurrentDateTime%], 'yyyy'));
  if $Year < 2026 then
    set $Through = 0;
  else
    if $Year = 2026 then
      set $Through = parseInteger(formatDateTime([%CurrentDateTime%], 'M'));
    end if;
  end if;
  return $Through;
end;
/

/**
 * Builds the report context: mode, subheading and the four headline figures.
 *
 * KPIs cover elapsed months only. Including future months would add their
 * zero actuals to spend and count every future cell as massively under
 * budget.
 *
 * @returns A fresh ReportContext in Actual mode
 */
create or modify microflow Ledger.DS_ReportContext ()
returns Ledger.ReportContext as $Context
folder 'Cashflow'
begin
  declare $Through integer = 0;
  declare $Income decimal = 0;
  declare $Spend decimal = 0;
  declare $Over integer = 0;
  declare $M integer = 1;
  declare $IsIncome boolean = false;

  $ThroughCalc = call microflow Ledger.CALC_ElapsedThrough ();
  set $Through = $ThroughCalc;

  retrieve $Groups from Ledger.CategoryGroup sort by SortOrder asc;
  loop $G in $Groups
  begin
    set $IsIncome = $G/GroupType = Ledger.GroupType.Income;
    retrieve $Cats from Ledger.Category
      where Ledger.Category_CategoryGroup = $G
      sort by SortOrder asc;
    loop $C in $Cats
    begin
      set $M = 1;
      while $M <= $Through
      begin
        $MK = call microflow Ledger.FMT_MonthKey (MonthIndex = $M);
        $A = call microflow Ledger.CALC_Actual (Category = $C, MonthKey = $MK);
        $B = call microflow Ledger.CALC_Budget (Category = $C, MonthKey = $MK);
        if $IsIncome then
          set $Income = $Income + $A;
          if $B - $A > $B * 0.02 then
            set $Over = $Over + 1;
          end if;
        else
          set $Spend = $Spend + $A;
          if $A - $B > $B * 0.02 then
            set $Over = $Over + 1;
          end if;
        end if;
        set $M = $M + 1;
      end while;
    end loop;
  end loop;

  $IncomeText = call microflow Ledger.FMT_Euro (Amount = $Income);
  $SpendText = call microflow Ledger.FMT_Euro (Amount = $Spend);
  $NetText = call microflow Ledger.FMT_Euro (Amount = $Income - $Spend);

  $Context = create Ledger.ReportContext (
    Mode = Ledger.ReportMode.Actual,
    Subheading = 'Twelve months of actuals against budget. Cell colour shows how far each category is over or under its monthly budget.',
    KpiIncome = $IncomeText,
    KpiSpend = $SpendText,
    KpiNet = $NetText,
    KpiOver = toString($Over) + ' cells',
    ElapsedThrough = $Through);

  return $Context;
end;
/

/**
 * Builds every row of the cashflow matrix for the context's mode.
 *
 * Order is group subtotal, then its categories, repeated per group, then the
 * net cashflow line.
 *
 * @param $Context Report context supplying the mode and the elapsed month
 * @returns Rows in display order
 */
create or modify microflow Ledger.DS_CashflowRows ($Context: Ledger.ReportContext)
returns list of Ledger.CashflowRow as $Rows
folder 'Cashflow'
begin
  declare $Order integer = 0;
  declare $Through integer = 0;
  declare $M integer = 1;
  declare $IsIncome boolean = false;
  declare $Elapsed boolean = false;
  declare $GroupActual decimal = 0;
  declare $GroupBudget decimal = 0;
  declare $RowTotal decimal = 0;
  declare $NetActual decimal = 0;
  declare $NetBudget decimal = 0;
  declare $GTotalText string = '';
  declare $CTotalText string = '';
  declare $NText string = '';

  $Rows = create list of Ledger.CashflowRow;
  set $Through = $Context/ElapsedThrough;

  retrieve $Groups from Ledger.CategoryGroup sort by SortOrder asc;

  loop $G in $Groups
  begin
    set $IsIncome = $G/GroupType = Ledger.GroupType.Income;
    retrieve $Cats from Ledger.Category
      where Ledger.Category_CategoryGroup = $G
      sort by SortOrder asc;

    -- Group subtotal row
    set $Order = $Order + 1;
    $GRow = create Ledger.CashflowRow (
      Label = $G/Name, RowKind = Ledger.RowKind.Group, SortOrder = $Order);
    set $RowTotal = 0;
    set $M = 1;
    while $M <= 12
    begin
      set $Elapsed = $M <= $Through;
      $GMK = call microflow Ledger.FMT_MonthKey (MonthIndex = $M);
      set $GroupActual = 0;
      set $GroupBudget = 0;
      loop $GC in $Cats
      begin
        $GA = call microflow Ledger.CALC_Actual (Category = $GC, MonthKey = $GMK);
        $GB = call microflow Ledger.CALC_Budget (Category = $GC, MonthKey = $GMK);
        set $GroupActual = $GroupActual + $GA;
        set $GroupBudget = $GroupBudget + $GB;
      end loop;

      $GText = call microflow Ledger.CALC_CellText (Mode = $Context/Mode,
        Actual = $GroupActual, Budget = $GroupBudget,
        IsIncome = $IsIncome, IsElapsed = $Elapsed);
      $GBand = call microflow Ledger.CALC_CellBand (Mode = $Context/Mode,
        Actual = $GroupActual, Budget = $GroupBudget,
        IsIncome = $IsIncome, IsElapsed = $Elapsed);
      $SetG = call microflow Ledger.SET_RowMonth (
        Row = $GRow, MonthIndex = $M, Text = $GText, Band = $GBand);

      if $Context/Mode = Ledger.ReportMode.Budget then
        set $RowTotal = $RowTotal + $GroupBudget;
      else
        if $Elapsed then
          if $Context/Mode = Ledger.ReportMode.Actual then
            set $RowTotal = $RowTotal + $GroupActual;
          else
            set $RowTotal = $RowTotal + (if $IsIncome then $GroupActual - $GroupBudget else $GroupBudget - $GroupActual);
          end if;
        end if;
      end if;
      set $M = $M + 1;
    end while;

    if $Context/Mode = Ledger.ReportMode.Variance then
      $GTotalV = call microflow Ledger.FMT_Variance (Amount = $RowTotal);
      set $GTotalText = $GTotalV;
    else
      $GTotalE = call microflow Ledger.FMT_Euro (Amount = $RowTotal);
      set $GTotalText = $GTotalE;
    end if;
    change $GRow (TotalText = $GTotalText);
    add $GRow to $Rows;

    -- One row per category in the group
    loop $C in $Cats
    begin
      set $Order = $Order + 1;
      $CRow = create Ledger.CashflowRow (
        Label = $C/Name, RowKind = Ledger.RowKind.Category, SortOrder = $Order);
      set $RowTotal = 0;
      set $M = 1;
      while $M <= 12
      begin
        set $Elapsed = $M <= $Through;
        $CMK = call microflow Ledger.FMT_MonthKey (MonthIndex = $M);
        $CA = call microflow Ledger.CALC_Actual (Category = $C, MonthKey = $CMK);
        $CB = call microflow Ledger.CALC_Budget (Category = $C, MonthKey = $CMK);

        $CText = call microflow Ledger.CALC_CellText (Mode = $Context/Mode,
          Actual = $CA, Budget = $CB, IsIncome = $IsIncome, IsElapsed = $Elapsed);
        $CBand = call microflow Ledger.CALC_CellBand (Mode = $Context/Mode,
          Actual = $CA, Budget = $CB, IsIncome = $IsIncome, IsElapsed = $Elapsed);
        $SetC = call microflow Ledger.SET_RowMonth (
          Row = $CRow, MonthIndex = $M, Text = $CText, Band = $CBand);

        if $Context/Mode = Ledger.ReportMode.Budget then
          set $RowTotal = $RowTotal + $CB;
        else
          if $Elapsed then
            if $Context/Mode = Ledger.ReportMode.Actual then
              set $RowTotal = $RowTotal + $CA;
            else
              set $RowTotal = $RowTotal + (if $IsIncome then $CA - $CB else $CB - $CA);
            end if;
          end if;
        end if;
        set $M = $M + 1;
      end while;

      if $Context/Mode = Ledger.ReportMode.Variance then
        $CTotalV = call microflow Ledger.FMT_Variance (Amount = $RowTotal);
        set $CTotalText = $CTotalV;
      else
        $CTotalE = call microflow Ledger.FMT_Euro (Amount = $RowTotal);
        set $CTotalText = $CTotalE;
      end if;
      change $CRow (TotalText = $CTotalText);
      add $CRow to $Rows;
    end loop;
  end loop;

  -- MARK: Net cashflow
  -- A second pass, because Mendix has no array to accumulate twelve running
  -- monthly nets during the pass above.

  set $Order = $Order + 1;
  $NRow = create Ledger.CashflowRow (
    Label = 'Net cashflow', RowKind = Ledger.RowKind.Net, SortOrder = $Order);
  set $RowTotal = 0;
  set $M = 1;
  while $M <= 12
  begin
    set $Elapsed = $M <= $Through;
    $NMK = call microflow Ledger.FMT_MonthKey (MonthIndex = $M);
    set $NetActual = 0;
    set $NetBudget = 0;

    loop $NG in $Groups
    begin
      retrieve $NCats from Ledger.Category
        where Ledger.Category_CategoryGroup = $NG;
      loop $NC in $NCats
      begin
        $NA = call microflow Ledger.CALC_Actual (Category = $NC, MonthKey = $NMK);
        $NB = call microflow Ledger.CALC_Budget (Category = $NC, MonthKey = $NMK);
        if $NG/GroupType = Ledger.GroupType.Income then
          set $NetActual = $NetActual + $NA;
          set $NetBudget = $NetBudget + $NB;
        else
          set $NetActual = $NetActual - $NA;
          set $NetBudget = $NetBudget - $NB;
        end if;
      end loop;
    end loop;

    @annotation 'Net is a figure, not a variance — Variance mode shows the actual net'
    if $Context/Mode = Ledger.ReportMode.Budget then
      $NTextB = call microflow Ledger.FMT_Euro (Amount = $NetBudget);
      set $NText = $NTextB;
      set $RowTotal = $RowTotal + $NetBudget;
    else
      if $Elapsed then
        $NTextA = call microflow Ledger.FMT_Euro (Amount = $NetActual);
        set $NText = $NTextA;
        set $RowTotal = $RowTotal + $NetActual;
      else
        set $NText = '';
      end if;
    end if;

    $SetN = call microflow Ledger.SET_RowMonth (
      Row = $NRow, MonthIndex = $M, Text = $NText, Band = '');
    set $M = $M + 1;
  end while;

  $NTotalText = call microflow Ledger.FMT_Euro (Amount = $RowTotal);
  change $NRow (TotalText = $NTotalText);
  add $NRow to $Rows;

  return $Rows;
end;
/

/**
 * Switches the report to Actual and refreshes the matrix.
 *
 * @param $Context Context to mutate
 * @returns true
 */
create or modify microflow Ledger.ACT_ModeActual ($Context: Ledger.ReportContext)
returns boolean as $Done
folder 'Cashflow'
begin
  declare $Done boolean = true;
  change $Context (
    Mode = Ledger.ReportMode.Actual,
    Subheading = 'Twelve months of actuals against budget. Cell colour shows how far each category is over or under its monthly budget.')
    refresh;
  return $Done;
end;
/

/**
 * Switches the report to Budget and refreshes the matrix.
 *
 * @param $Context Context to mutate
 * @returns true
 */
create or modify microflow Ledger.ACT_ModeBudget ($Context: Ledger.ReportContext)
returns boolean as $Done
folder 'Cashflow'
begin
  declare $Done boolean = true;
  change $Context (
    Mode = Ledger.ReportMode.Budget,
    Subheading = 'One amount per category per month. Months after the current one carry a budget but no actuals yet.')
    refresh;
  return $Done;
end;
/

/**
 * Switches the report to Variance and refreshes the matrix.
 *
 * @param $Context Context to mutate
 * @returns true
 */
create or modify microflow Ledger.ACT_ModeVariance ($Context: Ledger.ReportContext)
returns boolean as $Done
folder 'Cashflow'
begin
  declare $Done boolean = true;
  change $Context (
    Mode = Ledger.ReportMode.Variance,
    Subheading = 'Budget minus actual, sign-corrected per group: positive is favourable. Future months are blank.')
    refresh;
  return $Done;
end;
/
