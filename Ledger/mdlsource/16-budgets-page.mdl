-- ============================================================================
-- 16 - Budgets page
-- ============================================================================
-- The same fixed-width matrix idea as Cashflow, but every month cell is a
-- clickable container inside a custom-content column rather than a plain
-- attribute column. That is what buys per-cell editing: the container carries
-- both the click target and the override marking, and still shows the value.
--
-- Overridden months are marked rather than merely coloured differently — the
-- point of this screen is seeing where the household deviated from its own
-- baseline.
--
-- KNOWN ORDERING DEFECT: the copy panel at the foot of this page binds to
-- DS_BudgetCopyContext and ACT_CopyBudgets, which are defined in 29. Applying
-- this file to a project that has not yet run 29 fails with
-- `microflow not found` — verified, mxcli check --references reports it.
-- Re-applying the whole set over an existing .mpr is fine, which is why it has
-- not bitten, but a genuinely from-scratch build needs 29 run before this file.
-- The panel is authored here rather than inserted by 29 because an ALTER PAGE
-- INSERT from a later file is silently wiped the next time this file runs
-- (FINDINGS 103), which is the worse of the two failures: it is quiet.
-- ============================================================================

/**
 * Budgets: one amount per category per month, editable per cell.
 */
create or replace page Ledger.Budgets_Overview
(
  title: 'Budgets',
  layout: Atlas_Core.Atlas_Default,
  url: 'budgets',
  folder: 'Ledger'
)
{
  layoutgrid lgBudgets {
    row rowMain {
      column colBody (desktopwidth: 12) {
        dynamictext txtHeading (content: 'Budgets', rendermode: H2)
        dynamictext txtSub (
          content: 'One amount per category per month. Click a cell to change it. Months that override the category baseline are marked.',
          rendermode: paragraph,
          class: 'text-muted')

        -- The year selector and the matrix share one dataview, because the grid
        -- takes the context as a datasource parameter: stepping the year is a
        -- change-and-refresh on that one object, and the grid rebuilds itself.
        -- The same wiring the Cashflow mode switch uses.
        --
        -- Stepping rather than a list of years. The span is a property of the
        -- data — it grows every January, and an import of older statements moves
        -- the other end — so a fixed set of buttons or an enumeration would be
        -- wrong the moment either happened. The arrows disappear at the bounds
        -- instead of sitting there doing nothing.
        dataview dvYear (datasource: microflow Ledger.DS_BudgetContext) {
          container ctnYearBar (class: 'ledger-modes ledger-yearbar') {
            actionbutton btnYearPrev (
              caption: '← Earlier',
              visible: [IsFirst = false],
              action: microflow Ledger.ACT_BudgetYearPrev(Context: $currentObject))
            dynamictext txtYear (attribute: YearText, rendermode: H3, class: 'ledger-year')
            actionbutton btnYearNext (
              caption: 'Later →',
              visible: [IsLast = false],
              action: microflow Ledger.ACT_BudgetYearNext(Context: $currentObject))
            dynamictext txtYearRange (attribute: RangeText, class: 'text-muted')
          }

        datagrid dgBudgets (
          datasource: microflow Ledger.DS_BudgetRows(Context: $currentObject),
          PageSize: 20,
          class: 'ledger-matrix'
        ) {
          column colLabel (
            attribute: Label, caption: 'Category',
            Sortable: false, Draggable: false,
            ColumnWidth: manual, Size: 190,
            DynamicCellClass: '''bg-label''')
            column colM01 (caption: 'Jan', Alignment: right, ColumnWidth: manual, Size: 132) {
              container cellM01 (
                onclick: microflow Ledger.ACT_EditBudgetCell(Row: $currentObject, MonthIndex: 1),
                dynamicclasses: 'if $currentObject/M01IsOverride then ''bg-cell bg-override'' else ''bg-cell'''
              ) {
                dynamictext txtM01 (attribute: M01Text)
              }
            }
            column colM02 (caption: 'Feb', Alignment: right, ColumnWidth: manual, Size: 132) {
              container cellM02 (
                onclick: microflow Ledger.ACT_EditBudgetCell(Row: $currentObject, MonthIndex: 2),
                dynamicclasses: 'if $currentObject/M02IsOverride then ''bg-cell bg-override'' else ''bg-cell'''
              ) {
                dynamictext txtM02 (attribute: M02Text)
              }
            }
            column colM03 (caption: 'Mar', Alignment: right, ColumnWidth: manual, Size: 132) {
              container cellM03 (
                onclick: microflow Ledger.ACT_EditBudgetCell(Row: $currentObject, MonthIndex: 3),
                dynamicclasses: 'if $currentObject/M03IsOverride then ''bg-cell bg-override'' else ''bg-cell'''
              ) {
                dynamictext txtM03 (attribute: M03Text)
              }
            }
            column colM04 (caption: 'Apr', Alignment: right, ColumnWidth: manual, Size: 132) {
              container cellM04 (
                onclick: microflow Ledger.ACT_EditBudgetCell(Row: $currentObject, MonthIndex: 4),
                dynamicclasses: 'if $currentObject/M04IsOverride then ''bg-cell bg-override'' else ''bg-cell'''
              ) {
                dynamictext txtM04 (attribute: M04Text)
              }
            }
            column colM05 (caption: 'May', Alignment: right, ColumnWidth: manual, Size: 132) {
              container cellM05 (
                onclick: microflow Ledger.ACT_EditBudgetCell(Row: $currentObject, MonthIndex: 5),
                dynamicclasses: 'if $currentObject/M05IsOverride then ''bg-cell bg-override'' else ''bg-cell'''
              ) {
                dynamictext txtM05 (attribute: M05Text)
              }
            }
            column colM06 (caption: 'Jun', Alignment: right, ColumnWidth: manual, Size: 132) {
              container cellM06 (
                onclick: microflow Ledger.ACT_EditBudgetCell(Row: $currentObject, MonthIndex: 6),
                dynamicclasses: 'if $currentObject/M06IsOverride then ''bg-cell bg-override'' else ''bg-cell'''
              ) {
                dynamictext txtM06 (attribute: M06Text)
              }
            }
            column colM07 (caption: 'Jul', Alignment: right, ColumnWidth: manual, Size: 132) {
              container cellM07 (
                onclick: microflow Ledger.ACT_EditBudgetCell(Row: $currentObject, MonthIndex: 7),
                dynamicclasses: 'if $currentObject/M07IsOverride then ''bg-cell bg-override'' else ''bg-cell'''
              ) {
                dynamictext txtM07 (attribute: M07Text)
              }
            }
            column colM08 (caption: 'Aug', Alignment: right, ColumnWidth: manual, Size: 132) {
              container cellM08 (
                onclick: microflow Ledger.ACT_EditBudgetCell(Row: $currentObject, MonthIndex: 8),
                dynamicclasses: 'if $currentObject/M08IsOverride then ''bg-cell bg-override'' else ''bg-cell'''
              ) {
                dynamictext txtM08 (attribute: M08Text)
              }
            }
            column colM09 (caption: 'Sep', Alignment: right, ColumnWidth: manual, Size: 132) {
              container cellM09 (
                onclick: microflow Ledger.ACT_EditBudgetCell(Row: $currentObject, MonthIndex: 9),
                dynamicclasses: 'if $currentObject/M09IsOverride then ''bg-cell bg-override'' else ''bg-cell'''
              ) {
                dynamictext txtM09 (attribute: M09Text)
              }
            }
            column colM10 (caption: 'Oct', Alignment: right, ColumnWidth: manual, Size: 132) {
              container cellM10 (
                onclick: microflow Ledger.ACT_EditBudgetCell(Row: $currentObject, MonthIndex: 10),
                dynamicclasses: 'if $currentObject/M10IsOverride then ''bg-cell bg-override'' else ''bg-cell'''
              ) {
                dynamictext txtM10 (attribute: M10Text)
              }
            }
            column colM11 (caption: 'Nov', Alignment: right, ColumnWidth: manual, Size: 132) {
              container cellM11 (
                onclick: microflow Ledger.ACT_EditBudgetCell(Row: $currentObject, MonthIndex: 11),
                dynamicclasses: 'if $currentObject/M11IsOverride then ''bg-cell bg-override'' else ''bg-cell'''
              ) {
                dynamictext txtM11 (attribute: M11Text)
              }
            }
            column colM12 (caption: 'Dec', Alignment: right, ColumnWidth: manual, Size: 132) {
              container cellM12 (
                onclick: microflow Ledger.ACT_EditBudgetCell(Row: $currentObject, MonthIndex: 12),
                dynamicclasses: 'if $currentObject/M12IsOverride then ''bg-cell bg-override'' else ''bg-cell'''
              ) {
                dynamictext txtM12 (attribute: M12Text)
              }
            }
          column colTotal (
            attribute: TotalText, caption: 'Year', Alignment: right,
            Sortable: false, ColumnWidth: manual, Size: 140,
            DynamicCellClass: '''cf-total''')
        }
        }

        -- Copying a year is one insert-from-select per month rather than a
        -- create per category per month. It sits on this screen because this is
        -- where a household would think of it — in January, looking at last
        -- year's numbers.
        --
        -- Below the matrix, not above it. Its own From and To are independent of
        -- the year on screen, and above the stepper the two pairs of years read
        -- as one control: a grid showing 2023 under a panel saying 2026 → 2027
        -- invites you to believe the panel is labelling the grid.
        dataview dvCopy (datasource: microflow Ledger.DS_BudgetCopyContext) {
          container ctnCopyPanel (class: 'card ledger-rules-panel') {
            container ctnCopyFields (class: 'ledger-rules-figures') {
              dynamictext txtCopyHeading (content: 'Copy a year', rendermode: H5)
              dynamictext txtCopyStatus (attribute: Status, class: 'ledger-rules-status')
            }
            container ctnCopyActions (class: 'ledger-rules-actions') {
              textbox txtFromYear (label: 'From', attribute: FromYear)
              textbox txtToYear (label: 'To', attribute: ToYear)
              actionbutton btnCopyYear (
                caption: 'Copy overrides',
                action: microflow Ledger.ACT_CopyBudgets(Context: $currentObject),
                buttonstyle: primary)
            }
          }
        }
      }
    }
  }
}
/

-- Navigation is not written here. It used to be written by four files, each
-- carrying the menu as it stood at that point, so running any one of them on
-- its own silently reverted the menu to an older shape — a trap this project
-- fell into twice. It now has a single owner: 27-navigation.mdl.
