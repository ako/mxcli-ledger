-- ============================================================================
-- 23 - Cashflow sparklines (Vega-Lite through the VegaChart widget)
-- ============================================================================
-- Thirteen categories, each a twelve-month line over its budget envelope,
-- laid out as a small-multiple grid. It renders the same numbers as the matrix
-- directly above it, which is what makes it checkable: if a sparkline and its
-- matrix row disagree, one of them is wrong.
--
-- Why this chart and not another. It is the one rendering the existing stack
-- could not reasonably produce. Plotly has traces, not facets, so a grid of
-- thirteen small charts means thirteen hand-placed subplots with their own
-- axis pairs. In Vega-Lite `facet` is an operator: one spec, one mark
-- definition, and the grid falls out of the data.
--
-- What is different about how it is built. Everything the app renders through
-- CustomChart today has its *layout* assembled in a microflow — margins,
-- fonts, colours and the numbers all concatenated into one payload string.
-- Here the spec is a static property on the widget and the microflow emits
-- only a table of rows. The model never generates layout, so this file's
-- microflow is a query result rather than a document builder. That split is
-- the point of the prototype; the chart is the demonstration of it.
--
-- The x scale runs the full year while the actual line stops at the last
-- reported month. A zero actual for a month with no data would read as
-- maximally under budget — the trap PROTOTYPE-ANALYSIS §5.3 describes.
-- Emitting null rather than 0 makes Vega-Lite break the line instead of
-- drawing it to the floor.
--
-- That window is CALC_ReportingThrough, and this chart is why it exists: the
-- matrix had the same defect and had been shipping it, printing € 0 across
-- every row for the current month. A table cell reading € 0 is easy to skim
-- past; thirteen lines diving to the floor is not.
-- ============================================================================

/** What the sparkline grid binds to. */
create or modify non-persistent entity Ledger.SparklineContext (
  /** JSON array of {sortKey, category, group, month, actual, budget} rows */
  ChartData: string,
  /** e.g. '13 categories · 8 months elapsed' */
  SubText: string(120)
);
/

/**
 * A flat row per category per month: actual, budget, and the keys to facet on.
 *
 * Long format rather than the matrix's wide one. VMatrixActual carries twelve
 * M__Actual columns because a grid wants columns; a grammar of graphics wants
 * one row per observation, so the twelve are unpivoted here.
 *
 * Actual comes from VMatrixActual and budget from VCategoryBudget — two views
 * rather than one because joining BudgetOverride alongside Transaction fans
 * out and multiplies every actual (see VCategoryBudget's own documentation).
 * They are matched on SortKey, a key this code controls, rather than on a
 * display name.
 *
 * Amounts go through formatDecimal('0.00'): a Decimal stringifies with a long
 * tail and small values come out in scientific notation (FINDINGS 19), neither
 * of which is valid JSON.
 *
 * @returns The sparkline grid's context object
 */
create or modify microflow Ledger.DS_SparklineData ()
returns Ledger.SparklineContext as $Context
folder 'Cashflow'
begin
  declare $Rows string = '';
  declare $Sep string = '';
  declare $Month integer = 1;
  declare $Through integer = 0;
  declare $CatCount integer = 0;
  declare $BudgetVal decimal = 0;
  declare $ActualVal decimal = 0;
  declare $Cell string = '';
  retrieve $Matrix from Ledger.VMatrixActual sort by SortKey asc;
  retrieve $Budgets from Ledger.VCategoryBudget sort by SortKey asc;

  @annotation 'The same window the matrix and the KPIs use, so the sparkline cannot disagree with the row above it about which months exist.'
  $ThroughCalc = call microflow Ledger.CALC_ReportingThrough (Rows = $Matrix);
  set $Through = $ThroughCalc;

  @annotation 'Category rows only: the group subtotals and the net line are roll-ups of these, and a facet per roll-up would double-count the ink without adding a fact.'
  loop $R in $Matrix
  begin
    if $R/RowKind = 'Category' then
      set $CatCount = $CatCount + 1;
      set $Month = 1;

      while $Month <= 12
      begin
        set $ActualVal = 0;
        set $BudgetVal = 0;

        @annotation 'Matched on SortKey rather than on CategoryName — two categories may share a display name, and the sort key is generated by the view.'
        loop $B in $Budgets
        begin
          if $B/SortKey = $R/SortKey then
            $Bv = call microflow Ledger.GET_ViewBudget (B = $B, MonthIndex = $Month);
            set $BudgetVal = $Bv;
          end if;
        end loop;

        @annotation 'A month that has not elapsed emits a null actual, not a zero: zero against a full budget would draw the line to the floor and read as maximally under budget.'
        if $Month <= $Through then
          $Av = call microflow Ledger.GET_ViewActual (V = $R, MonthIndex = $Month);
          set $ActualVal = $Av;
          set $Cell = formatDecimal($ActualVal, '0.00');
        else
          set $Cell = 'null';
        end if;

        set $Rows = $Rows + $Sep
          + '{"sortKey":' + toString($R/SortKey)
          + ',"category":"' + $R/Label + '"'
          + ',"group":"' + $R/GroupName + '"'
          + ',"month":' + toString($Month)
          + ',"actual":' + $Cell
          + ',"budget":' + formatDecimal($BudgetVal, '0.00')
          + '}';
        set $Sep = ',';
        set $Month = $Month + 1;
      end while;
    end if;
  end loop;

  $Context = create Ledger.SparklineContext (
    ChartData = '[' + $Rows + ']',
    SubText = toString($CatCount) + ' categories · through month '
      + toString($Through) + ' · line is actual, band is budget, dot is over');

  return $Context;
end;
/

grant execute on microflow Ledger.DS_SparklineData to Ledger.User;
/

-- ----------------------------------------------------------------------------
-- The chart, inserted below the matrix on the existing Cashflow page.
--
-- ALTER PAGE rather than a rewrite of file 11: this is an addition, and file 11
-- also writes a navigation profile, so re-running it out of order would revert
-- the menu (a trap this project has hit twice). Inserting here keeps file 11
-- untouched and leaves navigation alone entirely.
--
-- The spec is a static property. It is committed, diffable, and never built at
-- runtime — the whole reason the microflow above stays as short as it is.
--
-- Idempotency, and the one place this file is not. Every other statement in
-- this project is `create or modify` / `create or replace`, so any file can be
-- re-run on its own. `ALTER PAGE ... INSERT` has no such form — no
-- `IF NOT EXISTS`, and `DROP WIDGET` has no `IF EXISTS` to pair it with — so
-- re-running *this file alone* against a page that already carries the chart
-- fails with "duplicate widget name 'lgSparkRow'". In the canonical flow it is
-- fine: file 11 recreates the page from scratch before this one inserts into
-- it. Applying the set in order works; applying this file twice does not.
-- ----------------------------------------------------------------------------
alter page Ledger.Cashflow_Overview {
  insert after lgMatrixRow {
    layoutgrid lgSparkRow {
      row rowSpark {
        column colSpark (desktopwidth: 12) {
          container ctnSpark (class: 'card ledger-card') {
            dynamictext lblSpark (content: 'Twelve months by category', rendermode: H6)
            dataview dvSpark (datasource: microflow Ledger.DS_SparklineData) {
              dynamictext subSpark (attribute: SubText, rendermode: paragraph, class: 'text-muted')
              pluggablewidget 'ledger.widget.web.vegachart.VegaChart' chartSparklines (
                chartData: ChartData,
                datasetName: 'table',
                chartHeight: 620,
                renderer: 'svg',
                showActions: false,
                spec: '{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "data": {"name": "table"},
  "background": null,
  "config": {
    "view": {"stroke": null},
    "axis": {"labelFont": "IBM Plex Mono", "labelFontSize": 8, "labelColor": "#8A8378",
             "domainColor": "#D9D2C6", "tickColor": "#D9D2C6", "grid": false},
    "header": {"labelFont": "IBM Plex Sans", "labelFontSize": 10, "labelColor": "#17181A",
               "labelAnchor": "start", "labelPadding": 2, "titleColor": "#8A8378"}
  },
  "facet": {
    "field": "category", "type": "nominal", "title": null,
    "sort": {"field": "sortKey", "op": "min"}
  },
  "columns": 4,
  "spec": {
    "width": 150,
    "height": 34,
    "layer": [
      {
        "description": "Budget envelope. Area from zero rather than a rule, so the line reads against a filled quantity instead of crossing a wire.",
        "mark": {"type": "area", "color": "#C9C2B4", "opacity": 0.35, "interpolate": "step-after"},
        "encoding": {"y": {"field": "budget", "type": "quantitative"}}
      },
      {
        "description": "Actual. Nulls after the last elapsed month break the line rather than drawing it to zero.",
        "mark": {"type": "line", "color": "#1B4D4B", "strokeWidth": 1.4},
        "encoding": {"y": {"field": "actual", "type": "quantitative"}}
      },
      {
        "description": "Over budget. The only place the chart spends a strong colour, and it marks the months worth looking at.",
        "transform": [{"filter": "isValid(datum.actual) && datum.actual > datum.budget"}],
        "mark": {"type": "point", "color": "#A8321E", "size": 14, "filled": true},
        "encoding": {"y": {"field": "actual", "type": "quantitative"}}
      }
    ],
    "encoding": {
      "x": {
        "field": "month", "type": "quantitative",
        "scale": {"domain": [1, 12], "nice": false},
        "axis": {"values": [1, 4, 7, 10], "title": null, "labelFlush": true, "tickSize": 2}
      },
      "y": {"axis": {"title": null, "tickCount": 2, "labelPadding": 1}},
      "tooltip": [
        {"field": "category", "type": "nominal", "title": "Category"},
        {"field": "month", "type": "quantitative", "title": "Month"},
        {"field": "actual", "type": "quantitative", "title": "Actual", "format": ",.2f"},
        {"field": "budget", "type": "quantitative", "title": "Budget", "format": ",.2f"}
      ]
    }
  },
  "resolve": {
    "description": "Independent y per facet. A shared scale would be more comparable in principle, but Rent against Coffee flattens every small category into the axis - the sparkline is read for its shape, and the budget band gives each one its own reference.",
    "scale": {"y": "independent"}
  }
}')
            }
          }
        }
      }
    }
  }
}
/
