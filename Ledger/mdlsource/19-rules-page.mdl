-- ============================================================================
-- 19 - Categories & rules screen
-- ============================================================================
-- Supersedes the read-only version created in 05. That one could not do better:
-- the engine did not exist yet, and 05 runs long before it. Rather than patch
-- the page in place — ALTER PAGE cannot bind actions (FINDINGS 45) — the whole
-- page is rebuilt here, once everything it needs is defined.
--
-- The panel above the rule list is the honest part of this screen. The
-- prototype showed a "N matched" number per rule that counted transactions
-- whose seeded category happened to equal the rule's, so it looked like the
-- engine worked. Here the number is what the rule actually categorised, which
-- starts at zero — and the panel says what running the rules *would* do, using
-- the same evaluation the run uses, so the promise and the outcome cannot
-- differ.
-- ============================================================================

/**
 * Categories & rules: the taxonomy, plus the rules that assign categories and
 * the controls to run them.
 */
create or replace page Ledger.Category_Overview
(
  title: 'Categories & rules',
  layout: Atlas_Core.Atlas_Default,
  url: 'categories',
  folder: 'Ledger'
)
{
  layoutgrid lgCategories {
    row rowMain {
      column colBody (desktopwidth: 12) {
        dynamictext txtHeading (content: 'Categories & rules', rendermode: H2)
        dynamictext txtSub (
          content: 'Two-level taxonomy plus the rules that assign categories. Rules run in order and the first match wins.',
          rendermode: paragraph,
          class: 'text-muted')

        dynamictext txtCatsHeading (content: 'Categories', rendermode: H4)
        datagrid dgCategories (
          datasource: database from Ledger.Category sort by SortOrder asc
        ) {
          column colCatName (attribute: Name, caption: 'Category')
          column colCatBudget (attribute: BaselineBudget, caption: 'Baseline budget / mo', Alignment: right)
          column colCatOrder (attribute: SortOrder, caption: 'Order', Alignment: right)
        }

        dynamictext txtRulesHeading (content: 'Rules', rendermode: H4)

        dataview dvRules (datasource: microflow Ledger.DS_RulesContext) {
          container ctnRulesPanel (class: 'card ledger-rules-panel') {
            container ctnRulesFigures (class: 'ledger-rules-figures') {
              dynamictext txtReview (attribute: ReviewText, rendermode: H5)
              dynamictext txtPreview (attribute: PreviewText, class: 'ledger-rules-preview')
              dynamictext txtStatus (attribute: StatusText, class: 'ledger-rules-status')
            }
            container ctnRulesActions (class: 'ledger-rules-actions') {
              actionbutton btnRunRules (
                caption: 'Run rules',
                action: microflow Ledger.ACT_ApplyRules(Context: $currentObject),
                buttonstyle: primary)
              actionbutton btnResetRules (
                caption: 'Undo rule assignments',
                action: microflow Ledger.ACT_ResetRuleAssignments(Context: $currentObject))
              actionbutton btnNewRule (
                caption: 'New rule',
                action: microflow Ledger.ACT_NewRule)
            }
          }
        }

        datagrid dgRules (
          datasource: database from Ledger.CategoryRule sort by SortOrder asc,
          class: 'ledger-rules-grid'
        ) {
          column colRuleOrder (
            attribute: SortOrder, caption: '#', Alignment: right,
            Sortable: false, ColumnWidth: manual, Size: 40)
          column colRuleField (
            attribute: RuleField, caption: 'Field',
            Sortable: false, ColumnWidth: manual, Size: 100)
          column colRuleOp (
            attribute: RuleOperator, caption: 'Operator',
            Sortable: false, ColumnWidth: manual, Size: 110)
          column colRuleValue (
            attribute: MatchValue, caption: 'Value',
            Sortable: false, ColumnWidth: manual, Size: 220)
          -- A dynamictext cannot walk an association; a nested dataview can.
          column colRuleCategory (
            caption: 'Assigns', Sortable: false,
            ColumnWidth: manual, Size: 150
          ) {
            dataview dvRuleCat (datasource: $currentObject/Ledger.CategoryRule_Category) {
              dynamictext txtRuleCat (attribute: Name)
            }
          }
          column colRuleHits (
            attribute: MatchCount, caption: 'Categorised', Alignment: right,
            Sortable: false, ColumnWidth: manual, Size: 100)
          -- Caption must not be empty: an empty one makes mx check report
          -- CE0463 'the definition of this widget has changed' on the whole
          -- grid, which says nothing about the actual cause. See FINDINGS 54.
          column colRuleActions (
            caption: 'Actions', Sortable: false,
            ColumnWidth: manual, Size: 200
          ) {
            container ctnRuleActions (class: 'ledger-row-actions') {
              actionbutton btnRuleUp (
                caption: '↑',
                action: microflow Ledger.ACT_MoveRuleUp(Rule: $currentObject))
              actionbutton btnRuleDown (
                caption: '↓',
                action: microflow Ledger.ACT_MoveRuleDown(Rule: $currentObject))
              actionbutton btnRuleEdit (
                caption: 'Edit',
                action: show_page Ledger.CategoryRule_Edit(Rule: $currentObject))
              actionbutton btnRuleDelete (
                caption: 'Delete',
                action: microflow Ledger.ACT_DeleteRule(Rule: $currentObject),
                buttonstyle: danger)
            }
          }
        }
      }
    }
  }
}
/
